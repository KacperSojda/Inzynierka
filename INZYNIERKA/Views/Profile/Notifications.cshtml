@model INZYNIERKA.Services.ViewModels.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5" style="max-width: 800px;">
    
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #111827;">Notifications</h2>
        <p class="text-muted">Manage your alerts and friend requests</p>
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var notification in Model.Notifications)
            {
                <div class="notification-card p-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center w-100">
                    
                    <div class="mb-3 mb-md-0 d-flex align-items-center">
                        @if (notification.NotificationType == NotificationType.FriendRequest)
                        {
                            <i class="bi bi-person-plus-fill me-3" style="font-size: 2rem; color: #1c7a15;"></i>
                            <div>
                                <span class="fw-bold text-dark fs-5">@notification.SenderUserName</span> sent you a friend request.
                                <br /><small class="text-muted"><i class="bi bi-clock me-1"></i>@notification.CreationDate.ToString("g")</small>
                            </div>
                        }
                        else if (notification.NotificationType == NotificationType.Message)
                        {
                            <i class="bi bi-chat-dots-fill me-3" style="font-size: 2rem; color: #1b3480;"></i>
                            <div>
                                New message from <span class="fw-bold text-dark fs-5">@notification.SenderUserName</span>.
                                <br /><small class="text-muted"><i class="bi bi-clock me-1"></i>@notification.CreationDate.ToString("g")</small>
                            </div>
                        }
                        else if (notification.NotificationType == NotificationType.GroupMessage)
                        {
                            <i class="bi bi-people-fill me-3" style="font-size: 2rem; color: #ae2eb8;"></i>
                            <div>
                                New message in group <span class="fw-bold text-dark fs-5">@notification.GroupName</span>.
                                <br /><small class="text-muted"><i class="bi bi-clock me-1"></i>@notification.CreationDate.ToString("g")</small>
                            </div>
                        }
                    </div>

                    <div class="action-menu gap-2">
                        @if (notification.NotificationType == NotificationType.FriendRequest)
                        {
                            <form asp-action="FriendRequestAccept" method="post" class="m-0">
                                <input type="hidden" name="notificationId" value="@notification.Id" />
                                <input type="hidden" name="senderUserName" value="@notification.SenderUserName" />
                                <button type="submit" class="action-btn btn-accept" title="Accept Request">
                                    <i class="bi bi-check-circle"></i> Accept
                                </button>
                            </form>
                        }

                        <form asp-action="DeleteNotification" method="post" class="m-0">
                            <input type="hidden" name="notificationId" value="@notification.Id" />
                            <button type="submit" class="action-btn btn-delete" title="Delete Notification">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <i class="bi bi-bell-slash text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">No notifications</h4>
            <p class="text-secondary">You're all caught up!</p>
        </div>
    }
</div>

<style>
    .notification-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        border-left: 5px solid #ae2eb8;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .notification-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .action-menu {
        display: flex;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: 12px;
        height: 40px;
        text-decoration: none;
        color: white;
        font-weight: bold;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            color: white;
        }

    .btn-delete {
        background: linear-gradient(135deg, #8c144c, #d43780);
        width: 50px;
    }

    .btn-accept {
        background: linear-gradient(135deg, #1c7a15, #32b528);
        min-width: 100px;
        gap: 5px;
    }
</style>