@{
    ViewData["Title"] = "Zmień Awatar";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="form-card text-center p-5 w-100" style="max-width: 500px;">
        <div class="mb-3">
            <i class="bi bi-image" style="font-size: 3rem; color: #552459;"></i>
        </div>
        <h2 class="fw-bold mb-4" style="color: #111827;">Change Avatar</h2>

        <form asp-action="EditAvatar" asp-controller="Profile" method="post" enctype="multipart/form-data">
            <div class="mb-4 text-start">
                <label class="form-label fw-bold text-muted">Choose a new image file</label>
                <input type="file" name="AvatarFile" class="form-control custom-input" accept="image/*" />
            </div>
            
            <button type="submit" class="action-btn w-100">Save</button>
        </form>
    </div>
</div>

<style>
    .form-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .custom-input {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-input:focus {
            border-color: #ae2eb8;
            box-shadow: 0 0 0 0.25rem rgba(174, 46, 184, 0.25);
        }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 0;
        border-radius: 15px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        color: white;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .action-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
            color: white;
        }
</style>