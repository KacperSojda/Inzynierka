@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="my-container">
    <div class="my-card w-100" style="max-width: 700px;">
        <h2 class="text-center fw-bold mb-4">Edit Profile, @Model.UserName</h2>

        <form asp-action="EditProfile" method="post" novalidate id="profile-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Avatar" />
            <input type="hidden" asp-for="UserName" />

            <div class="mb-4">
                <label asp-for="PublicDescription" class="form-label fw-bold text-muted">Public Description</label>
                <input asp-for="PublicDescription" class="form-control my-input"/>
                <span asp-validation-for="PublicDescription" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="PrivateDescription" class="form-label fw-bold text-muted">Private Description</label>
                <input asp-for="PrivateDescription" class="form-control my-input"/>
                <span asp-validation-for="PrivateDescription" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="BirthDate" class="form-label fw-bold text-muted">Date of Birth</label>
                    <input asp-for="BirthDate" class="form-control custom-input" type="date" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Zodiac" class="form-label fw-bold text-muted">Zodiac Sign</label>
                    <select asp-for="Zodiac" class="form-select custom-input"
                            asp-items="Html.GetEnumSelectList<INZYNIERKA.Domain.Models.ZodiacSign>()">
                        <option value="">Choose sign...</option>
                    </select>
                    <span asp-validation-for="Zodiac" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="City" class="form-label fw-bold text-muted">City</label>
                    <input asp-for="City" class="form-control custom-input" placeholder="e.g. Warsaw" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-4">
                    <label asp-for="Country" class="form-label fw-bold text-muted">Country</label>
                    <input asp-for="Country" class="form-control custom-input" placeholder="e.g. Poland" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-bold text-muted">Custom Status</label>
                <input asp-for="Status" class="form-control custom-input" placeholder="What's on your mind?" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted">Language</label>
                <div id="flag-container" class="d-flex flex-wrap gap-2">
                    <button type="button" class="flag-btn" data-lang="Polish">🇵🇱 Polish</button>
                    <button type="button" class="flag-btn" data-lang="English">🇬🇧 English</button>
                    <button type="button" class="flag-btn" data-lang="German">🇩🇪 German</button>
                    <button type="button" class="flag-btn" data-lang="Spanish">🇪🇸 Spanish</button>
                    <button type="button" class="flag-btn" data-lang="French">🇫🇷 French</button>
                    <button type="button" class="flag-btn" data-lang="Italian">🇮🇹 Italian</button>
                    <button type="button" class="flag-btn" data-lang="Ukrainian">🇺🇦 Ukrainian</button>
                </div>
                <span asp-validation-for="Language" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-main gradient-main">Save changes</button>
        </form>

        <div class="text-center mt-4">
            <form asp-action="DeleteAccount" asp-controller="Account" method="post" onsubmit="return confirm('Are you sure you want to deactivate your account? You will not be able to log in again.');">
                <button type="submit" class="text-center w-50 d-block mx-auto text-decoration-none btn-main gradient-pink">
                    <i class="bi bi-trash3 me-2"></i> Delete Account
                </button>
            </form>
        </div>

    </div>
</div>

<style>
    .flag-btn {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 8px 15px;
        font-size: 1rem;
        transition: all 0.2s ease;
        color: #6b7280;
        font-weight: 500;
        filter: grayscale(100%);
        opacity: 0.7;
    }

    .flag-btn:hover {
        filter: grayscale(0%);
        opacity: 1;
        border-color: #ae2eb8;
    }

    .flag-btn.selected {
        filter: grayscale(0%);
        opacity: 1;
        border-color: #ae2eb8;
        background: rgba(174, 46, 184, 0.05);
        color: #ae2eb8;
        box-shadow: 0 2px 8px rgba(174, 46, 184, 0.2);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            const flagBtns = document.querySelectorAll('.flag-btn');
            const hiddenLangInput = document.getElementById('HiddenPreferredLanguage');
            
            let selectedLang = hiddenLangInput.value ? hiddenLangInput.value.trim() : "";

            flagBtns.forEach(btn => {
                if (btn.dataset.lang === selectedLang) {
                    btn.classList.add('selected');
                }

                btn.addEventListener('click', () => {
                    flagBtns.forEach(b => b.classList.remove('selected'));
                    
                    btn.classList.add('selected');
                    
                    hiddenLangInput.value = btn.dataset.lang;
                });
            });
        });
    </script>
}