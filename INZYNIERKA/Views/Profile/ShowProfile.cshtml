@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Profil użytkownika";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex flex-column flex-lg-row justify-content-center align-items-center align-items-lg-start gap-4">
    
    <div class="profile-card w-100 shadow-lg mb-0" style="max-width: 850px; border-radius: 20px; overflow: hidden; background: white;">
        
        <div class="profile-cover" style="height: 260px; background: @(string.IsNullOrEmpty(Model.Cover) ? "linear-gradient(135deg, #2a082e, #552459)" : $"url('{Model.Cover}') center/cover no-repeat");">
        </div>

        <div class="p-4 p-md-5 pt-0 text-start">
            
            <div style="margin-top: -180px; position: relative; z-index: 2; margin-bottom: 20px;">
                <img src="@Model.Avatar" alt="Avatar" class="rounded-circle shadow-lg" style="width: 190px; height: 190px; object-fit: cover; border: 6px solid white; background: white;" />
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="fw-bold mb-0" style="color: #111827;">
                    @Model.UserName
                    @if (Model.Age.HasValue)
                    {
                        <span class="text-muted fw-normal ms-1 fs-4">@Model.Age</span>
                    }
                </h2>
                
                @if (!string.IsNullOrEmpty(Model.Status))
                {
                    <span class="badge rounded-pill bg-light text-dark border border-secondary shadow-sm px-3 py-2 fst-italic ms-2 mt-1 mt-sm-0">
                        "@Model.Status"
                    </span>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-4 mb-3 text-muted fw-medium fs-6">
                @if (!string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.Country))
                {
                    <div>
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @(string.Join(", ", new[] { Model.City, Model.Country }.Where(s => !string.IsNullOrEmpty(s))))
                    </div>
                }

                @if (Model.BirthDate.HasValue)
                {
                    <div>
                        <i class="bi bi-cake2-fill text-primary me-1"></i>
                        @Model.BirthDate.Value.ToString("dd.MM.yyyy")
                    </div>
                }

                @if (Model.Zodiac != null && (int)Model.Zodiac != 0)
                {
                    <div>
                        <i class="bi bi-stars text-warning me-1"></i>
                        @Model.Zodiac
                    </div>
                }
            </div>

            <div class="tags-wrapper d-flex flex-wrap gap-2 mb-4">
                @if (Model.Tags != null && Model.Tags.Any())
                {
                    foreach (var tag in Model.Tags)
                    {
                        <span class="badge custom-badge shadow-sm">@tag</span>
                    }
                }
                else
                {
                    <span class="text-muted fst-italic">Brak tagów.</span>
                }
            </div>

            <hr class="mb-4" style="opacity: 0.1;" />

            <div class="row g-5">
                
                <div class="col-md-7">
                    
                    @if (!string.IsNullOrEmpty(Model.Language))
                    {
                        <h5 class="fw-bold mb-3" style="color: #111827;">Języki:</h5>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <span class="badge bg-secondary rounded-pill px-3 py-2 fw-normal"><i class="bi bi-chat-left-text me-1"></i> @Model.Language.Trim()</span>
                        </div>
                    }

                    <h5 class="fw-bold mb-2" style="color: #111827;">Opis publiczny:</h5>
                    <p class="text-secondary mb-4" style="line-height: 1.6;">
                        @(string.IsNullOrEmpty(Model.PublicDescription) ? "Brak opisu." : Model.PublicDescription)
                    </p>

                    @if (!string.IsNullOrEmpty(Model.PrivateDescription))
                    {
                        <h5 class="fw-bold mb-2" style="color: #111827;">Opis prywatny:</h5>
                        <p class="text-secondary mb-0" style="line-height: 1.6;">@Model.PrivateDescription</p>
                    }
                </div>

                <div class="col-md-5">
                    @if (!string.IsNullOrEmpty(Model.SocialMedia))
                    {
                        <div class="p-4 rounded-4" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                            <h5 class="fw-bold mb-3" style="color: #111827;">Social Media</h5>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var link in Model.SocialMedia.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var cleanLink = link.Trim();
                                    <a href="@cleanLink" target="_blank" class="btn btn-outline-dark rounded-pill px-3 py-2 text-start d-flex align-items-center shadow-sm" style="overflow: hidden; white-space: nowrap;">
                                        <i class="bi bi-link-45deg fs-4 me-2"></i>
                                        <span class="text-truncate">@cleanLink.Replace("https://", "").Replace("http://", "").TrimEnd('/')</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <div class="home-menu d-flex flex-row flex-lg-column justify-content-center flex-wrap gap-3">
        <a asp-controller="Chat" asp-action="Chat" asp-route-friendId="@Model.Id" class="btn-profile btn-chat" title="Napisz wiadomość" data-bs-toggle="tooltip">
            <i class="bi bi-chat-dots-fill"></i> <span>Chat</span>
        </a>
        
    </div>

</div>

<style>
    .custom-badge {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        padding: 8px 15px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 500;
        color: white;
    }

    .btn-profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 15px 10px;
        border-radius: 15px;
        width: 140px;
        text-decoration: none;
        color: white;
        font-weight: bold;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .btn-profile i {
            font-size: 1.6rem;
            margin-bottom: 5px;
        }

        .btn-profile span {
            font-size: 0.95rem;
        }

        .btn-profile:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
            color: white;
        }

    .btn-chat {
        background: linear-gradient(135deg, #1b3480, #4565c4);
    }
</style>