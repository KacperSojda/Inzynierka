@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "User profile";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex justify-content-center">
    
    <div class="profile-card p-5 w-100 text-center" style="max-width: 600px;">
        
        <div class="mb-4">
            <img src="@Model.Avatar" alt="Avatar" class="profile-avatar rounded-circle shadow-sm" />
        </div>
        
        <h2 class="fw-bold mb-2" style="color: #111827;">@Model.UserName</h2>
        <p class="text-muted fs-5 mb-4">@Model.PublicDescription</p>

        <h5 class="fw-bold mb-3" style="color: #111827;">User tags:</h5>
        
        <div class="tags-wrapper d-flex justify-content-center flex-wrap gap-2 mb-5">
            @foreach (var tag in Model.Tags)
            {
                <span class="badge custom-badge">@tag</span>
            }
        </div>

        <div class="d-flex justify-content-center">
            <a asp-controller="Chat" asp-action="Chat" asp-route-friendId="@Model.Id" class="action-btn btn-chat" title="Napisz wiadomość" data-bs-toggle="tooltip">
                <i class="bi bi-chat-dots fs-5"></i> <span>Chat</span>
            </a>
        </div>
        
    </div>
</div>

<style>
    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border: 4px solid #f8f9fa;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .custom-badge {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        padding: 8px 15px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: 0 4px 10px rgba(174, 46, 184, 0.2);
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 30px;
        border-radius: 15px;
        min-width: 160px;
        text-decoration: none;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-chat {
        background: linear-gradient(135deg, #1b3480, #4565c4);
    }

    .action-btn:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        color: white;
    }
</style>