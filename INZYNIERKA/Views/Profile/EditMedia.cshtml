@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Zarządzaj zdjęciami";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex flex-column align-items-center">
    <div class="edit-card w-100 p-4 mb-4" style="max-width: 800px; background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <h2 class="text-center fw-bold mb-4" style="color: #111827;">Profile Branding</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-pill px-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-pill px-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="live-preview-box position-relative mb-5" style="border-radius: 15px; overflow: hidden; border: 1px solid #e5e7eb;">
            
            <div class="preview-cover" style="height: 200px; background: @(string.IsNullOrEmpty(Model.Cover) ? "linear-gradient(135deg, #2a082e, #552459)" : $"url('{Model.Cover}') center/cover no-repeat"); transition: all 0.3s;"></div>
            
            <div class="preview-avatar-wrapper" style="position: absolute; bottom: 15px; left: 30px; z-index: 3;">
                <img src="@Model.Avatar" alt="Avatar" class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover; border: 5px solid white; box-shadow: 0 4px 15px rgba(0,0,0,0.2);" />
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 h-100 row-form-card">
                    <h5 class="fw-bold mb-3"><i class="bi bi-image-fill text-purple me-2"></i>Cover Photo</h5>
                    <form asp-action="EditCover" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Choose a panoramic banner (Max 2MB)</label>
                            <input type="file" name="CoverFile" class="form-control custom-file-input" accept=".jpg,.jpeg,.png" required />
                        </div>
                        <button type="submit" class="btn btn-purple w-100 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Update Cover
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 h-100 row-form-card">
                    <h5 class="fw-bold mb-3"><i class="bi bi-person-circle text-purple me-2"></i>Avatar</h5>
                    <form asp-action="EditAvatar" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Choose a square image (Max 2MB)</label>
                            <input type="file" name="AvatarFile" class="form-control custom-file-input" accept=".jpg,.jpeg,.png" required />
                        </div>
                        <button type="submit" class="btn btn-purple w-100 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Update Avatar
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Back to Profile
            </a>
        </div>
    </div>
</div>

<style>
    .text-purple {
        color: #ae2eb8;
    }
    
    .row-form-card {
        background: #f9fafb;
        border-radius: 15px;
        border: 1px solid #f3f4f6;
    }

    .custom-file-input {
        border-radius: 10px;
        padding: 10px;
        border: 1px solid #d1d5db;
    }

        .custom-file-input:focus {
            border-color: #ae2eb8;
            box-shadow: 0 0 0 0.25rem rgba(174, 46, 184, 0.15);
        }

    .btn-purple {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        padding: 10px 0;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-purple:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(174, 46, 184, 0.3);
            color: white;
        }
</style>