@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Profile Home Page";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex flex-column align-items-center">
    
    <div class="profile-card p-5 mb-5 w-100" style="max-width: 800px;">
        <div class="row align-items-center">
            <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="@Model.Avatar" alt="Avatar" class="profile-avatar rounded-circle shadow-sm" />
            </div>
            <div class="col-md-8 text-center text-md-start">
                <h2 class="fw-bold mb-2" style="color: #111827;">@Model.UserName</h2>
                <p class="text-muted fs-5 mb-4">@Model.PublicDescription</p>

                <h5 class="fw-bold" style="color: #111827;">Private Description:</h5>
                <p class="text-secondary mb-4">@Model.PrivateDescription</p>

                <h5 class="fw-bold mb-3" style="color: #111827;">Your tags:</h5>
                <div class="tags-wrapper d-flex justify-content-center justify-content-md-start flex-wrap gap-2">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge custom-badge">@tag</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="home-menu d-flex justify-content-center flex-wrap gap-3 w-100" style="max-width: 800px;">
        <a asp-controller="Profile" asp-action="EditProfile" class="btn-profile btn-edit" title="Edit profile" data-bs-toggle="tooltip">
            <i class="bi bi-pencil-square"></i> <span>Edit</span>
        </a>
        <a asp-controller="Profile" asp-action="SelectTags" class="btn-profile btn-tags" title="Edit tags" data-bs-toggle="tooltip">
            <i class="bi bi-tags"></i> <span>Tags</span>
        </a>
        <a asp-controller="Profile" asp-action="FriendList" class="btn-profile btn-friends" title="Friend list" data-bs-toggle="tooltip">
            <i class="bi bi-people-fill"></i> <span>Friends</span>
        </a>
        <a asp-controller="Profile" asp-action="RequestList" class="btn-profile btn-requests" title="Friend requests" data-bs-toggle="tooltip">
            <i class="bi bi-person-badge"></i> <span>Requests</span>
        </a>
        <a asp-controller="Profile" asp-action="EditAvatar" class="btn-profile btn-avatar" title="Edit Avatar" data-bs-toggle="tooltip">
            <i class="bi bi-image"></i> <span>Avatar</span>
        </a>
    </div>

</div>

<style>
    .profile-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .profile-avatar {
        width: 180px;
        height: 180px;
        object-fit: cover;
        border: 4px solid #f8f9fa;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .custom-badge {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        padding: 8px 15px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: 0 4px 10px rgba(174, 46, 184, 0.2);
    }

    .btn-profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 15px 10px;
        border-radius: 15px;
        width: 140px;
        text-decoration: none;
        color: white;
        font-weight: bold;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-profile i {
        font-size: 1.6rem;
        margin-bottom: 5px;
    }

    .btn-profile span {
        font-size: 1rem;
    }

    .btn-profile:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        color: white;
    }

    .btn-edit     { background: linear-gradient(135deg, #757009, #cfc61d); }
    .btn-tags     { background: linear-gradient(135deg, #89838a, #c4c0c4); }
    .btn-friends  { background: linear-gradient(135deg, #1c7a15, #32b528); }
    .btn-requests { background: linear-gradient(135deg, #8c144c, #d43780); }
    .btn-avatar   { background: linear-gradient(135deg, #1b3480, #4565c4); }
</style>