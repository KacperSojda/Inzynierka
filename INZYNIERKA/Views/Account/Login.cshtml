@using INZYNIERKA.Services.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
}

<div class="my-container">
    <div class="my-card">
        <h2 class="fw-bold text-center mb-4">Login</h2>
        <form asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control my-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold"></label>
                <input asp-for="Password" type="password" class="form-control my-input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <a asp-controller="Account" asp-action="VerifyEmail" class="forgot-pass">
                    Forgot Password?
                </a>
            </div>

            <div class="mb-3 text-center">
                <button type="submit" class="btn-main gradient-main">Log In</button>
            </div>
        </form>
        <div class="mb-3 text-center">
            <a asp-controller="Home" asp-action="Index" class="d-block text-decoration-none btn-main gradient-main">Back to Home</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}

<style>

    .forgot-pass {
        color: #ae2eb8;
        text-decoration: none;
        font-weight: 500;
    }

    .forgot-pass:hover {
        color: #552459;
    }

</style>