@using INZYNIERKA.Services.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Login</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control custom-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold"></label>
                <input asp-for="Password" type="password" class="form-control custom-input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-controller="Account" asp-action="VerifyEmail" class="forgot-link">
                    Forgot Password?
                </a>
            </div>

            <div class="mb-3 text-center">
                <button type="submit" class="auth-btn">Log In</button>
            </div>

            <div class="text-center mt-3">
                <a asp-controller="Home" asp-action="Index" class="auth-btn-secondary">Back to Home</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 450px;
    }

    .auth-title {
        color: #111827;
        font-weight: 700;
        text-align: center;
        margin-bottom: 30px;
    }

    .custom-input {
        border-radius: 10px;
        padding: 10px 15px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .custom-input:focus {
        border-color: #ae2eb8;
        box-shadow: 0 0 0 0.25rem rgba(174, 46, 184, 0.25);
    }

    .forgot-link {
        color: #ae2eb8;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .forgot-link:hover {
        color: #552459;
        text-decoration: underline;
    }

    .auth-btn {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 12px 0;
        width: 100%;
        font-weight: bold;
        font-size: 1.1rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .auth-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        color: white;
    }

    .auth-btn-secondary {
        background: transparent;
        color: #552459;
        border: 2px solid #ae2eb8;
        border-radius: 15px;
        padding: 10px 0;
        width: 100%;
        font-weight: bold;
        display: inline-block;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .auth-btn-secondary:hover {
        background: rgba(174, 46, 184, 0.1);
        color: #552459;
    }
</style>