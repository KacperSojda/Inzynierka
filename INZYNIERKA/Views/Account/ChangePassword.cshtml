@using INZYNIERKA.Services.ViewModels;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
}

<div class="my-container">
    <div class="my-card">
        <h2 class="fw-bold text-center mb-4">Change Password</h2>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div>
                <input type="hidden" asp-for="Email" />
            </div>

            <div class="mb-3">
                <label asp-for="OtpCode" class="form-label fw-bold">OTP Code</label>
                <input asp-for="OtpCode" class="form-control my-input fw-bold text-center" placeholder="000000" maxlength="6" autocomplete="off" style="letter-spacing: 5px;" />
                <span asp-validation-for="OtpCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                <input asp-for="NewPassword" class="form-control my-input" type="password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control my-input" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3 text-center">
                <button type="submit" class="btn-main gradient-main">Change Password</button>
            </div>

            <div class="text-center mt-3">
                <a asp-action="VerifyEmail" class="d-block text-decoration-none btn-main gradient-main">Back to Home</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}