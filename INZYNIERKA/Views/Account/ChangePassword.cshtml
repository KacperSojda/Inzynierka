@using INZYNIERKA.Services.ViewModels;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Change Password</h2>
        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div>
                <input type="hidden" asp-for="Email" />
            </div>

            <div class="mb-3">
                <label asp-for="OtpCode" class="form-label fw-bold">Kod weryfikacyjny</label>
                <input asp-for="OtpCode" class="form-control custom-input form-control-lg text-center fw-bold"
                       placeholder="000000" maxlength="6" autocomplete="off" style="letter-spacing: 5px;" />
                <span asp-validation-for="OtpCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-bold"></label>
                <input asp-for="NewPassword" class="form-control custom-input" placeholder="Nowe hasło" type="password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                <input asp-for="ConfirmPassword" class="form-control custom-input" placeholder="Powtórz nowe hasło" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3 text-center">
                <button type="submit" class="auth-btn">Change Password</button>
            </div>

            <div class="text-center mt-3">
                <a asp-controller="Account" asp-action="VerifyEmail" class="auth-btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-card {
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 450px;
    }

    .auth-title {
        color: #111827;
        font-weight: 700;
        text-align: center;
        margin-bottom: 30px;
    }

    .custom-input {
        border-radius: 10px;
        padding: 10px 15px;
        border: 1px solid #ced4da;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-input:focus {
            border-color: #ae2eb8;
            box-shadow: 0 0 0 0.25rem rgba(174, 46, 184, 0.25);
        }

    .auth-btn {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 12px 0;
        width: 100%;
        font-weight: bold;
        font-size: 1.1rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .auth-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
            color: white;
        }

    .auth-btn-secondary {
        background: transparent;
        color: #552459;
        border: 2px solid #ae2eb8;
        border-radius: 15px;
        padding: 10px 0;
        width: 100%;
        font-weight: bold;
        display: inline-block;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .auth-btn-secondary:hover {
            background: rgba(174, 46, 184, 0.1);
            color: #552459;
        }
</style>