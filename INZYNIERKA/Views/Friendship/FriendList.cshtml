@model List<INZYNIERKA.Services.ViewModels.FriendViewModel>

@{
    ViewData["Title"] = "Your FriendList";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #111827;">Friend list</h2>
        <p class="text-muted">Manage your friends and start chatting</p>
    </div>

    <div class="d-flex flex-column align-items-center gap-3">
        <form method="get" asp-action="FriendList" class="mb-4 w-100" style="max-width: 800px;">
            <div class="input-group shadow-sm" style="border-radius: 15px; border: 1px solid #f0f0f0; overflow: hidden;">
                
                <input type="text" name="searchQuery" value="@Context.Request.Query["searchQuery"]" class="form-control border-0 py-2 shadow-none" placeholder="Search by name...">
                
                <button type="submit" class="btn px-4 border-0" style="background: linear-gradient(135deg, #552459, #ae2eb8); color: white;">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                
                @if (!string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
                {
                    <a asp-action="FriendList" class="btn btn-light px-3 border-start d-flex align-items-center" title="Clear search">
                        <i class="bi bi-x-lg text-danger"></i>
                    </a>
                }
            </div>
        </form>

        @if (Model.Any())
        {
            @foreach (var friend in Model)
            {
                <div class="list-card d-flex align-items-center justify-content-between friend-item p-3 px-4 w-100" style="max-width: 800px;" data-name="@friend.UserName.ToLower()">
                    <div class="d-flex align-items-center">
                        <strong class="fs-5 me-2" style="color: @(friend.IsDeleted ? "#6c757d" : "#111827"); text-decoration: @(friend.IsDeleted ? "line-through" : "none");">
                            @friend.UserName
                        </strong>
                        
                        @if (friend.IsDeleted)
                        {
                            <span class="badge bg-danger ms-2" style="font-size: 0.75rem;">[deleted]</span>
                        }
                        else
                        {
                            <span class="statusIndicator ms-1" data-friend-id="@friend.Id" title="Offline" style="font-size: 1em; color: gray; transition: color 0.3s ease;">●</span>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3 mt-md-0">
                        <form asp-action="DeleteFriend" method="post" class="m-0">
                            <input type="hidden" name="friendId" value="@friend.Id" />
                            <button type="submit" class="action-btn btn-delete" title="Delete" data-bs-toggle="tooltip">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>

                        @if (!friend.IsDeleted)
                        {
                            <a asp-controller="Chat" asp-action="Chat" asp-route-friendId="@friend.Id" class="action-btn btn-chat" title="Chat" data-bs-toggle="tooltip">
                                <i class="bi bi-chat-dots"></i>
                            </a>

                            <a asp-controller="Profile" asp-action="ShowProfile" asp-route-userId="@friend.Id" class="action-btn btn-profile" title="Show Profile" data-bs-toggle="tooltip">
                                    <i class="bi bi-person"></i>
                            </a>
                        }
                    </div>
                </div>
            }
            int currentPage = ViewBag.CurrentPage ?? 1;
            int totalPages = ViewBag.TotalPages ?? 1;
            string currentSearch = Context.Request.Query["searchQuery"];

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4 w-100" style="max-width: 800px;">
                    <nav aria-label="Nawigacja stron znajomych">
                        <ul class="pagination pagination-sm shadow-sm" style="border-radius: 10px;">
                            
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link text-dark" asp-action="FriendList" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link @(currentPage == i ? "text-white" : "text-dark")" 
                                       style="@(currentPage == i ? "background: linear-gradient(135deg, #552459, #ae2eb8); border-color: #ae2eb8;" : "")"
                                       asp-action="FriendList" 
                                       asp-route-searchQuery="@currentSearch" 
                                       asp-route-page="@i">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link text-dark" asp-action="FriendList" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center mt-5 w-100">
                <i class="bi bi-people text-muted" style="font-size: 4rem;"></i>
                @if (!string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
                {
                    <h4 class="mt-3 text-muted">No friends found with that name.</h4>
                }
                else
                {
                    <h4 class="mt-3 text-muted">You don't have any friends yet.</h4>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const connection = window.appSignalRConnection;

        function setUserStatus(userId, isOnline) {
            const dots = document.querySelectorAll('.statusIndicator');
            dots.forEach(dot => {
                if (dot.getAttribute('data-friend-id').toLowerCase() === userId.toLowerCase()) {
                    dot.style.color = isOnline ? "green" : "gray";
                    dot.title = isOnline ? "Online" : "Offline";
                }
            });
        }

        connection.on("Online", function(userId) {
            setUserStatus(userId, true);
        });
        
        connection.on("Offline", function(userId) {
            setUserStatus(userId, false);
        });
        
        async function checkAllFriendsStatus() {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                const dots = document.querySelectorAll('.statusIndicator');
                for (let dot of dots) {
                    const friendId = dot.getAttribute('data-friend-id');
                    try {
                        const isOnline = await connection.invoke("CheckStatus", friendId);
                        setUserStatus(friendId, isOnline);
                    } catch (err) {
                        console.error(`Failed to retrieve status for ${friendId}:`, err);
                    }
                }
            } else if (connection) {
                setTimeout(checkAllFriendsStatus, 50);
            }
        }

        checkAllFriendsStatus();
    </script>
}

<style>
    .list-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .list-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border-radius: 12px;
        width: 60px;
        height: 45px;
        text-decoration: none;
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-btn i {
        font-size: 1.2rem;
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white;
    }

    .btn-delete  { background: linear-gradient(135deg, #8c144c, #d43780); }
    .btn-chat    { background: linear-gradient(135deg, #1b3480, #4565c4); }
    .btn-profile { background: linear-gradient(135deg, #757009, #cfc61d); }
</style>