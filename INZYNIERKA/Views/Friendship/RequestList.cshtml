@model List<INZYNIERKA.Services.ViewModels.FriendViewModel>

@{
    ViewData["Title"] = "Your Requests";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #111827;">List of invited people</h2>
        <p class="text-muted">Manage your pending friend requests</p>
    </div>

    @if (Model.Any())
    {
        <div class="d-flex flex-column align-items-center gap-3">
            @foreach (var friend in Model)
            {
                <div class="card-friendlist d-flex justify-content-between align-items-center p-3 px-4 w-100" style="max-width: 600px;">
                    <strong class="fs-5" style="color: #111827;">@friend.UserName</strong>
                    
                    <form asp-action="DeleteRequest" method="post" class="m-0">
                        <input type="hidden" name="friendId" value="@friend.Id" />
                        <button type="submit" class="btn-friendlist gradient-pink" title="Delete" data-bs-toggle="tooltip">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </div>
            }
            @{
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
            }

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4 w-100" style="max-width: 600px;">
                    <nav aria-label="Nawigacja stron zaproszeń">
                        <ul class="pagination pagination-sm shadow-sm" style="border-radius: 10px;">
                            
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link text-dark" asp-action="RequestList" asp-route-page="@(currentPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link @(currentPage == i ? "text-white" : "text-dark")"
                                       style="@(currentPage == i ? "background: linear-gradient(135deg, #552459, #ae2eb8); border-color: #ae2eb8;" : "")"
                                       asp-action="RequestList"
                                       asp-route-page="@i">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link text-dark" asp-action="RequestList" asp-route-page="@(currentPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <i class="bi bi-envelope-paper text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">No invitations sent</h4>
        </div>
    }
</div>