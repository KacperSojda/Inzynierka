@model INZYNIERKA.Services.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "Chat";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-4 d-flex justify-content-center">
    <div class="chat-card p-4 w-100" style="max-width: 900px;">
        
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <h3 class="mb-0 d-flex align-items-center fw-bold" style="color: #111827;">
                <i class="bi bi-person-circle me-2" style="color: #552459;"></i>
                @Model.FriendName
                <span id="statusIndicator" title="Offline" style="font-size: 0.6em; color: gray; transition: color 0.3s ease; margin-left: 10px;">●</span>
            </h3>
            <a asp-controller="Profile" asp-action="ShowProfile" asp-route-userId="@Model.FriendId" class="action-btn btn-profile" style="min-width: 130px; height: 40px; padding: 5px 15px; font-size: 0.95rem;">
                <i class="bi bi-person me-1"></i> Profile
            </a>
        </div>

        <div id="chatWindow" class="chat-window-container p-3 mb-2">
            @{
                var lastSentMsg = Model.Messages.LastOrDefault(m => m.SenderId == Model.CurrentUserId);
            }

            @foreach (var msg in Model.Messages)
            {
                <div class="message-container mb-3">
                    <strong style="color: @(msg.SenderId == Model.CurrentUserId ? "#ae2eb8" : "#111827");">
                        @(msg.SenderId == Model.CurrentUserId ? "You" : msg.SenderName):
                    </strong>
                    
                    @if (msg.IsImage)
                    {
                        <br />
                        <img src="data:@msg.ImageType;base64,@msg.ImageDataBase64" class="chat-image" />
                    }
                    else
                    {
                        <span class="ms-1">@msg.Content</span>
                    }

                    @if (msg == lastSentMsg)
                    {
                        <div class="read-status-container text-muted mt-1" style="text-align: right; font-size: 0.75em;">
                            @(msg.IsRead ? "Wyświetlono ✓✓" : "Dostarczono ✓")
                        </div>
                    }
                </div>
            }
        </div>

        <div id="typingIndicator" class="text-muted mb-3 ms-2" style="display: none; font-size: 0.85em; font-style: italic;">
            <i class="bi bi-pencil-fill me-1" style="font-size: 0.75em;"></i> @Model.FriendName pisze...
        </div>

        <div class="input-group mb-4 shadow-sm" style="border-radius: 15px; overflow: hidden;">
            <input type="file" id="imageInput" accept="image/*" style="display:none;" />
            <button class="btn btn-light border" type="button" onclick="document.getElementById('imageInput').click()" title="Wyślij zdjęcie">
                <i class="bi bi-image" style="color: #552459; font-size: 1.2rem;"></i>
            </button>

            <button class="btn btn-light border" type="button" id="emojiTriggerBtn" title="Wstaw Emoji">
                <i class="bi bi-emoji-smile" style="color: #552459; font-size: 1.2rem;"></i>
            </button>

            <input type="text" id="messageInput" class="form-control custom-chat-input border-start-0 border-end-0"
                   placeholder="Write a message..."
                   value="@(string.IsNullOrEmpty(Model?.UserMessage) ? "" : Model.UserMessage)" />
            
            <button id="sendButton" class="action-btn btn-send" style="border-radius: 0; min-width: 100px;">
                <i class="bi bi-send-fill me-1"></i> Send
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Model.GeminiAnswer))
        {
            <div class="gemini-box p-3 mb-4 d-flex gap-3">
                <i class="bi bi-robot" style="font-size: 2rem; color: #ae2eb8;"></i>
                <div style="white-space: pre-wrap; line-height: 1.5;">
                    <strong style="color: #552459; font-size: 1.1rem;">Gemini AI:</strong><br />
                    @Model.GeminiAnswer
                </div>
            </div>
        }

        <div class="menu-ai gap-3">
            <form method="post" asp-action="ResponseHelp" class="flex-grow-1">
                <input type="hidden" name="FriendId" value="@Model.FriendId" />
                <button type="submit" class="action-btn btn-ai w-100"><i class="bi bi-lightbulb me-1"></i> Help with response</button>
            </form>

            <form id="CorrectForm" method="post" asp-action="CorrectMessage" class="flex-grow-1">
                <input type="hidden" name="FriendId" value="@Model.FriendId" />
                <input type="hidden" id="userMessageCorrect" name="UserMessage" value="" />
                <button type="submit" class="action-btn btn-ai w-100"><i class="bi bi-spellcheck me-1"></i> Correct message</button>
            </form>

            <form id="TranslateForm" method="post" asp-action="TranslateMessage" class="flex-grow-1">
                <input type="hidden" name="FriendId" value="@Model.FriendId" />
                <input type="hidden" id="userMessageTranslate" name="UserMessage" value="" />
                <button type="submit" class="action-btn btn-ai w-100"><i class="bi bi-translate me-1"></i> Translate</button>
            </form>

            <form method="post" asp-action="SummarizeChat" class="flex-grow-1">
                <input type="hidden" name="FriendId" value="@Model.FriendId" />
                <button type="submit" class="action-btn btn-ai-special w-100"><i class="bi bi-stars me-1"></i> Summarize last 7 days</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@joeattardi/emoji-button@3.1.1/dist/index.min.js"></script>
    <script>
        // Konfiguracja SignalR //
        const connection = window.appSignalRConnection;

        function setOnlineStatus(isOnline) {
            console.log(">>> [KROPKA] Wymuszam zmianę koloru na:", isOnline ? "ZIELONY (Online)" : "SZARY (Offline)");
            const dot = document.getElementById("statusIndicator");
            if (isOnline) {
                dot.style.color = "#32b528";
                dot.title = "Online";
            } 
            else {
                dot.style.color = "gray";
                dot.title = "Offline";
            }
        }

        connection.on("UserIsOnline", function(userId) {
            console.log(">>> [ZDARZENIE ODBIORU] Ktoś wszedł na serwer! ID tej osoby to:", userId);
            console.log(">>> [PORÓWNANIE] Czy to mój znajomy? (Moje ID znajomego to: @Model.FriendId):", userId.toLowerCase() === "@Model.FriendId".toLowerCase());
            
            if (userId && userId.toLowerCase() === "@Model.FriendId".toLowerCase()) {
                setOnlineStatus(true);
            }
        });

        connection.on("UserIsOffline", function(userId) {
            console.log(">>> [ZDARZENIE ODBIORU] Ktoś wyszedł! ID tej osoby to:", userId);
            if (userId && userId.toLowerCase() === "@Model.FriendId".toLowerCase()) {
                setOnlineStatus(false);
            }
        });

        async function checkFriendStatus() {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    const isOnline = await connection.invoke("CheckIfUserIsOnline", "@Model.FriendId");
                    setOnlineStatus(isOnline);
                } 
                catch (err) 
                {
                    console.error("Nie udało się pobrać statusu:", err);
                }
            } 
            else if (connection)
            {
                setTimeout(checkFriendStatus, 50);
            }
        }

        checkFriendStatus();

        const chatWindow = document.getElementById("chatWindow");

        // Infinite scroll //
        let loadedMessagesCount = 30;
        let isLoadingOlder = false;
        let hasMoreMessages = true;

        chatWindow.addEventListener("scroll", async function() {
            if (chatWindow.scrollTop === 0 && !isLoadingOlder && hasMoreMessages) {
                isLoadingOlder = true;
                const previousScrollHeight = chatWindow.scrollHeight;

                try {
                    const response = await fetch(`/Chat/LoadOlderMessages?friendId=@Model.FriendId&skip=${loadedMessagesCount}`);
                    if (response.ok) {
                        const olderMessages = await response.json();

                        if (olderMessages.length > 0) {
                            loadedMessagesCount += olderMessages.length;
                            let olderHtml = "";
        
                            olderMessages.forEach(msg => {
                                const senderName = msg.senderId === "@Model.CurrentUserId" ? "You" : "@Model.FriendName";
                                const colorStyle = msg.senderId === "@Model.CurrentUserId" ? "color: #ae2eb8;" : "color: #111827;";
                                let contentHtml = msg.isImage ?
                                `<br/><img src="data:${msg.contentType};base64,${msg.imageDataBase64}" class="chat-image" />` :
                                `<span class="ms-1">${msg.content}</span>`;
                                    
                                olderHtml += `<div class="message-container mb-3"><strong style="${colorStyle}">${senderName}:</strong> ${contentHtml}</div>`;
                            });

                            chatWindow.insertAdjacentHTML('afterbegin', olderHtml);
                            chatWindow.scrollTop = chatWindow.scrollHeight - previousScrollHeight;
                        }

                        if (olderMessages.length < 30) 
                        {
                            hasMoreMessages = false;
                        }
                    }
                } 
                catch (err) 
                {
                    console.error("Błąd przy ładowaniu starszych wiadomości", err);
                } 
                finally 
                {
                    isLoadingOlder = false;
                }
            }
        });

        // Message handling //
        function appendMessage(senderId, content, isHtml) {
            const currentUserId = "@Model.CurrentUserId";
            const chatWindow = document.getElementById("chatWindow");
            const div = document.createElement("div");
            div.className = "message-container mb-3";
            const senderName = senderId === currentUserId ? "You" : "@Model.FriendName";
            const colorStyle = senderId === currentUserId ? "color: #ae2eb8;" : "color: #111827;";
            
            let innerContent = `<strong style="${colorStyle}">${senderName}:</strong> `;
            
            if (isHtml) 
            {
            innerContent += content;
            } 
            else 
            {
                const tempDiv = document.createElement("div");
                tempDiv.innerText = content;
                innerContent += `<span class="ms-1">${tempDiv.innerHTML}</span>`;
            }

            if (senderId === currentUserId) {
                document.querySelectorAll('.read-status-container').forEach(el => el.remove());
                innerContent += `<div class="read-status-container text-muted mt-1" style="text-align: right; font-size: 0.75em;">Dostarczono ✓</div>`;
            }

            div.innerHTML = innerContent;
            chatWindow.appendChild(div);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        // SignalR events //
        connection.on("ReceiveImage", function(senderId, receiverId, base64Data, contentType) {
            const imgHtml = `<br/><img src="data:${contentType};base64,${base64Data}" class="chat-image" />`;
            appendMessage(senderId, imgHtml, true);
        });

        connection.on("ReceiveMessage", function(senderId, receiverId, message) {
            appendMessage(senderId, message, false);
        });

        connection.on("ErrorNotification", function(errorMessage) {
            alert(errorMessage);
        });

        connection.on("MessagesRead", function(readerId) {
            if (readerId === "@Model.FriendId") {
                document.querySelectorAll('.read-status-container').forEach(el => {
                    el.innerText = "Wyświetlono ✓✓";
                    el.style.color = "#3b82f6";
                });
            }
        });

        let hideIndicatorTimeout = null;
        const typingIndicator = document.getElementById("typingIndicator");

        connection.on("ReceiveTypingIndicator", function(senderId) {
            if (senderId === "@Model.FriendId") {
                typingIndicator.style.display = "block";
                
                clearTimeout(hideIndicatorTimeout);
                hideIndicatorTimeout = setTimeout(function() {
                    typingIndicator.style.display = "none";
                }, 2000);
            }
        });

        // Users Interactions //
        function notifyMessagesRead() {
            const currentUserId = "@Model.CurrentUserId";
            const friendId = "@Model.FriendId";

            connection.invoke("MarkAsRead", currentUserId, friendId)
            .catch(err => console.error("MarkAsRead err:", err.toString()));

            connection.invoke("ClearNotifications", currentUserId, friendId)
            .catch(err => console.error("ClearNotifications err:", err.toString()));
        }

        document.getElementById("messageInput").addEventListener("focus", notifyMessagesRead);
        document.getElementById("chatWindow").addEventListener("click", notifyMessagesRead);

        setTimeout(notifyMessagesRead, 1500);

        let lastTypingTime = 0;
        document.getElementById("messageInput").addEventListener("input", function() {
            const now = Date.now();
            
            if (now - lastTypingTime > 1500) {
                connection.invoke("SendTypingIndicator", "@Model.CurrentUserId", "@Model.FriendId")
                .catch(err => console.error("TypingIndicator err:", err.toString()));
                
                lastTypingTime = now;
            }
        });

        document.getElementById("sendButton").addEventListener("click", function() {
            const messageInput = document.getElementById("messageInput");
            const message = messageInput.value;

            if (!message.trim()) return;

                connection.invoke("SendMessage", "@Model.CurrentUserId", "@Model.FriendId", message)
                .catch(err => console.error(err.toString()));

                messageInput.value = "";
            });

        document.getElementById("imageInput").addEventListener("change", function() {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onloadend = function() {
                const base64Data = reader.result.split(',')[1];
                const contentType = file.type;

                connection.invoke("SendImage", "@Model.CurrentUserId", "@Model.FriendId", base64Data, contentType)
                .catch(err => console.error(err.toString()));
            };
            reader.readAsDataURL(file);
            this.value = "";
        });

        // Emoji //
        const emojiTriggerBtn = document.getElementById("emojiTriggerBtn");
        const msgInput = document.getElementById("messageInput");

        const picker = new EmojiButton({
            position: 'top-start',
            theme: 'light',
            autoHide: false
        });

        picker.on('emoji', emoji => {
            msgInput.value += emoji;
            msgInput.focus();
        });

        emojiTriggerBtn.addEventListener('click', () => {
            picker.togglePicker(emojiTriggerBtn);
        });

        // Forms binding //
        function bindMessageToForm(formId, hiddenInputId) {
            document.getElementById(formId).addEventListener("submit", function() {
                var message = document.getElementById("messageInput").value;
                document.getElementById(hiddenInputId).value = message;
            });
        }

        bindMessageToForm("CorrectForm", "userMessageCorrect");
        bindMessageToForm("TranslateForm", "userMessageTranslate");
    </script>

    <style>
        .chat-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .chat-window-container {
            height: 400px;
            overflow-y: auto;
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 15px;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
        }

        .chat-window-container::-webkit-scrollbar {
            width: 8px;
        }

        .chat-window-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .chat-window-container::-webkit-scrollbar-thumb {
            background: #c4c0c4;
            border-radius: 10px;
        }

        .chat-window-container::-webkit-scrollbar-thumb:hover {
            background: #ae2eb8;
        }

        .chat-image {
            max-width: 250px;
            border-radius: 12px;
            margin-top: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .custom-chat-input {
            box-shadow: none !important;
            border-color: #dee2e6;
        }

        .custom-chat-input:focus {
            background-color: #fcf8fd;
        }

        .gemini-box {
            background: linear-gradient(to right, #fdfbfe, #f4e8f6);
            border-left: 5px solid #ae2eb8;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(174, 46, 184, 0.08);
        }

        .menu-ai {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 20px;
            border-radius: 15px;
            font-weight: bold;
            text-decoration: none;
            color: white;
            border: none;
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            cursor: pointer;
        }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            color: white;
        }

        .btn-send {
            background: linear-gradient(135deg, #552459, #ae2eb8);
        }

        .btn-profile {
            background: linear-gradient(135deg, #757009, #cfc61d);
        }

        .btn-ai {
            background: linear-gradient(135deg, #1b3480, #4565c4);
        }

        .btn-ai-special {
            background: linear-gradient(135deg, #ae2eb8, #3b82f6);
        }
    </style>
}