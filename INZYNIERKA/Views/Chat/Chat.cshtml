@model INZYNIERKA.Services.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "Chat";
    var isLastMessageFromFriend = Model.Messages.LastOrDefault()?.SenderId == Model.FriendId;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container-fluid py-4 px-lg-4">
    <div class="row g-4 justify-content-center">
        
        <!-- Lewa kolumna -->
        <div class="col-xl-2 col-lg-4 d-flex flex-column">
            <div class="card-body d-flex flex-column p-4">
                    
                <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                    <i class="bi bi-journal-text fs-3 text-primary me-2"></i>
                    <h5 class="fw-bold mb-0">AI Summary</h5>
                </div>

                <div class="mb-4">
                    <label class="small fw-bold text-muted mb-2"> Select period:</label>
                    <div class="d-flex flex-column gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0">From:</span>
                            <input type="date" id="summaryDateStart" class="form-control bg-light border-0" value="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0">To:</span>
                            <input type="date" id="summaryDateEnd" class="form-control bg-light border-0" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                        <button onclick="generateChatSummary()" class="btn btn-gradient-ai btn-sm w-100 mt-2">
                            <i class="bi bi-stars me-1"></i> Generate Summary
                        </button>
                    </div>
                </div>

                <div id="summaryResultContainer" class="flex-grow-1 overflow-auto" style="max-height: 400px;">
                    <div class="text-center text-muted fst-italic mt-4">
                        <i class="bi bi-calendar-range fs-1 d-block mb-2"></i>
                        Select dates and click the button.
                    </div>
                </div>

            </div>
        </div>

        <!-- Środkowa kolumna -->
        <div class="col-xl-7 col-lg-8 d-flex flex-column">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex flex-column p-4">
                
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        
                        <h4 class="mb-0 fw-bold d-flex align-items-center">
                            <i class="bi bi-person-circle text-secondary me-2"></i>
                            @Model.FriendName
                            <span id="statusIndicator" title="Offline" class="ms-2" style="font-size: 0.5em; color: gray;">●</span>
                        </h4>
                        
                        <div class="d-flex align-items-center gap-3">
                            
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input shadow-sm" type="checkbox" id="autoTranslateSwitch">
                                <label class="form-check-label text-muted small fw-bold" for="autoTranslateSwitch" title="Tłumaczy każdą Twoją wiadomość na język znajomego">
                                    <i class="bi bi-translate text-primary me-1"></i> Auto-Translate
                                </label>
                            </div>

                            <a asp-controller="Profile" asp-action="ShowProfile" asp-route-userId="@Model.FriendId" class="btn btn-gradient-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-person"></i> Profil
                            </a>
                            
                        </div>
                    </div>

                    <div id="chatWindow" class="chat-scrollable bg-light rounded-3 p-3 mb-3 flex-grow-1 border">
                        @{ 
                            var lastSentMsg = Model.Messages.LastOrDefault(m => m.SenderId == Model.CurrentUserId);
                            DateTime? lastDate = null;
                        }

                        @foreach (var msg in Model.Messages)
                        {
                            var msgDate = msg.Timestamp.Date; 

                            if (lastDate == null || lastDate.Value != msgDate)
                            {
                                <div class="d-flex align-items-center justify-content-center my-4 date-separator">
                                    <hr class="flex-grow-1 text-muted opacity-25 m-0">
                                    <span class="mx-3 text-muted fw-bold" style="font-size: 0.75rem; background-color: #f8f9fa; padding: 2px 10px; border-radius: 10px;">
                                        @if (msgDate == DateTime.Today)
                                        {
                                            <text>Dzisiaj</text>
                                        }
                                        else if (msgDate == DateTime.Today.AddDays(-1))
                                        {
                                            <text>Wczoraj</text>
                                        }
                                        else
                                        {
                                            <text>@msgDate.ToString("dd MMMM yyyy")</text>
                                        }
                                    </span>
                                    <hr class="flex-grow-1 text-muted opacity-25 m-0">
                                </div>
                                lastDate = msgDate; 
                            }

                            <div class="mb-3">
                                <strong class="@(msg.SenderId == Model.CurrentUserId ? "text-primary" : "text-dark")">
                                    @(msg.SenderId == Model.CurrentUserId ? "You" : msg.SenderName):
                                </strong>
                                
                                @if (msg.IsImage)
                                {
                                    <br />
                                    <img src="data:@msg.ImageType;base64,@msg.ImageData" class="chat-image rounded-3 mt-2" style="max-width: 250px;" />
                                }
                                else
                                {
                                    <span class="ms-1">@msg.Content</span>
                                }

                                @if (msg == lastSentMsg)
                                {
                                    <div class="text-muted mt-1 text-end" style="font-size: 0.75em;">
                                        @(msg.Readed ? "Displayed" : "Delivered")
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div id="typingIndicator" class="text-muted mb-2 ms-2 small fst-italic" style="display: none;">
                        <i class="bi bi-pencil-fill me-1"></i> @Model.FriendName writing...
                    </div>

                    <div class="input-group mb-3 border rounded-pill overflow-hidden p-1 bg-white">
                        <input type="file" id="imageInput" accept="image/*" style="display:none;" />
                        
                        <button class="btn btn-gradient-send border-0 rounded-circle" type="button" onclick="document.getElementById('imageInput').click()" title="Send Image">
                            <i class="bi bi-image"></i>
                        </button>

                        <button class="btn btn-gradient-send border-0 rounded-circle mx-1" type="button" id="emojiTriggerBtn" title="Insert Emoji">
                            <i class="bi bi-emoji-smile"></i>
                        </button>

                        <input type="text" id="messageInput" class="form-control border-0 shadow-none"
                               placeholder="Write a message..."
                               value="@(string.IsNullOrEmpty(Model?.UserMessage) ? "" : Model.UserMessage)" />
                        
                        <button id="sendButton" class="btn btn-gradient-send rounded-pill px-4">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <form id="CorrectForm" method="post" asp-action="CorrectMessage" class="flex-grow-1">
                            <input type="hidden" name="FriendId" value="@Model.FriendId" />
                            <input type="hidden" id="userMessageCorrect" name="UserMessage" value="" />
                             <button type="submit" class="btn btn-gradient-ai btn-sm w-100 mt-2"><i class="bi bi-spellcheck me-1"></i> Correct</button>
                        </form>

                        <form id="TranslateForm" method="post" asp-action="TranslateMessage" class="flex-grow-1">
                            <input type="hidden" name="FriendId" value="@Model.FriendId" />
                            <input type="hidden" id="userMessageTranslate" name="UserMessage" value="" />
                             <button type="submit" class="btn btn-gradient-ai btn-sm w-100 mt-2"><i class="bi bi-translate me-1"></i> Translate</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>

        <!-- Środkowa kolumna -->
        <div class="col-xl-3 d-none d-xl-flex flex-column">
            <div class="card-body d-flex flex-column p-4">
                    
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-robot fs-3 text-primary me-2"></i>
                        <h5 class="fw-bold mb-0">Smart Replies</h5>
                    </div>
                
                    <button class="btn btn-sm btn-light rounded-circle shadow-sm border" type="button" data-bs-toggle="collapse" data-bs-target="#smartRepliesConfig" aria-expanded="false" aria-controls="smartRepliesConfig" title="Ustawienia AI">
                        <i class="bi bi-gear-fill" style="color: #552459;"></i>
                    </button>
                </div>

                <div class="collapse mb-3" id="smartRepliesConfig">
                    <div class="card card-body border-0 shadow-sm bg-light p-3 rounded-3" style="font-size: 0.85rem;">
                        <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">AI Settings</h6>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="autoGenerateSwitch" @(Model.Auto ? "checked" : "") onchange="saveSmartReplySettings()">
                            <label class="form-check-label text-muted fw-bold" for="autoGenerateSwitch">Auto-generate</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted fw-bold mb-1">Response Style:</label>
                            <select class="form-select form-select-sm border-0 shadow-sm" id="smartReplyTone" onchange="onToneChange()">
                                <option value="casual" selected="@(Model.Tone == "casual")">Casual</option>
                                <option value="formal" selected="@(Model.Tone == "formal")">Formal</option>
                                <option value="funny" selected="@(Model.Tone == "funny")">Funny</option>
                                <option value="custom" selected="@(Model.Tone == "custom")">Custom...</option>
                            </select>
                        </div>

                        <div id="customStyleContainer" class="@(Model.Tone == "custom" ? "" : "d-none")">
                            <label class="form-label text-muted fw-bold mb-1">Describe your style:</label>
                            <textarea class="form-control form-control-sm border-0 shadow-sm rounded-3 py-2" id="customStyleInput" rows="3" placeholder="e.g. Respond very briefly..." onchange="saveSmartReplySettings()">@Model.Auto</textarea>
                        </div>

                        <div id="refreshRepliesContainer" class="mt-3 border-top pt-3 @(Model.Auto ? "" : "d-none")">
                            <button type="button" class="btn btn-sm btn-gradient-ai w-100 shadow-sm" onclick="generateSmartReply()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Suggestions
                            </button>
                        </div>
                    </div>
                </div>
                    
                <p class="text-muted small mb-4">AI will generate a suggestion after receiving a message.</p>
                    
                <div id="smartRepliesContainer" class="d-flex flex-column gap-2">
                    <div class="text-center text-muted fst-italic mt-4">
                        <i class="bi bi-chat-left-dots fs-1 d-block mb-2"></i>
                        Waiting for a message...
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@joeattardi/emoji-button@3.1.1/dist/index.min.js"></script>
    <script>
        const connection = window.appSignalRConnection;

        const emoticonsMap = {
            ":)": "🙂",
            ":D": "😀",
            "xD": "😆",
            "XD": "😆",
            "xd": "😆",
            "^^": "😊",
            "^_^": "😊",
            ":(": "🙁",
            ":'(": "😢",
            "T_T": "😭",
            ";(": "😥",
            ";)": "😉",
            ":*": "😘",
            ":-*": "😘",
            ":O": "😲",
            ":o": "😲",
            ":P": "😛",
            ":p": "😛",
            "xP": "😝",
            "XP": "😝",
            ">:<": "😠",
            "-_-": "😑",
            ">_>": "😒",
            "<_<": "😒",
            "B)": "😎",
            "8)": "😎",
            "O:)": "😇",
            "o:)": "😇",
            ":/": "😕",
            ":\\": "😕",
            ":|": "😐",
            "<3": "❤️",
            "</3": "💔",
            "(y)": "👍",
            "(Y)": "👍",
            "(n)": "👎",
            "(N)": "👎"
        };

        function parseEmoticons(text) {
        if (!text) return text;
        let parsedText = text;
        for (const [emoticon, emoji] of Object.entries(emoticonsMap)) {
        const regex = new RegExp(emoticon.replace(/([.*+?^=!:${}()|\[\]\/\\])/g, "\\$1"), "g");
        parsedText = parsedText.replace(regex, emoji);
        }
        return parsedText;
        }

        // SMART REPLIES //
        const smartRepliesContainer = document.getElementById("smartRepliesContainer");
        const isLastMsgFromFriend = @isLastMessageFromFriend.ToString().ToLower();

        if (isLastMsgFromFriend) {
            tryGenerateReplyWhenConnected();
        }

        function tryGenerateReplyWhenConnected() {
            const isAuto = document.getElementById("autoGenerateSwitch").checked;
            if (!isAuto) return;

            if (connection && connection.state === signalR.HubConnectionState.Connected) {
            generateSmartReply();
            } else {
            setTimeout(tryGenerateReplyWhenConnected, 50);
            }
        }

        function onToneChange() {
            toggleCustomStyleField();
            saveSmartReplySettings();
        }

        async function saveSmartReplySettings() {
            const isAuto = document.getElementById("autoGenerateSwitch").checked;
            const tone = document.getElementById("smartReplyTone").value;
            const custom = document.getElementById("customStyleInput").value;
            
            const refreshContainer = document.getElementById("refreshRepliesContainer");
            if (isAuto) {
                refreshContainer.classList.remove("d-none");
            } 
            else {
                refreshContainer.classList.add("d-none");
            }
            
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    await connection.invoke("SaveSmartReplySettings", "@Model.FriendId", tone, custom, isAuto);
                    console.log("Konfiguracja AI została zapisana w bazie.");
                } 
                catch (err) {
                    console.error("Błąd podczas zapisu konfiguracji AI:", err);
                }
            }
        }

        async function generateSmartReply() {
            smartRepliesContainer.innerHTML = `
            <div class="d-flex align-items-center justify-content-center p-4 border rounded-3" style="background: rgba(174, 46, 184, 0.05);">
            <div class="spinner-grow spinner-grow-sm me-2" style="color: #ae2eb8;" role="status"></div>
            <span class="text-muted fw-bold" style="color: #552459 !important;">Gemini myśli...</span>
            </div>`;
            try {
                const aiReplies = await connection.invoke("SmartReply", "@Model.FriendId");
                if (Array.isArray(aiReplies) && aiReplies.length > 0) {
                    let buttonsHtml = '';
                    aiReplies.forEach(reply => {
                        buttonsHtml += `<button class="btn btn-gradient-smart text-start w-100 mb-2 border bg-white"
                        onclick="useSmartReply(this.dataset.reply)"
                        data-reply="${reply.replace(/"/g, '&quot;')}">
                        <i class="bi bi-stars text-primary me-1"></i> ${reply}
                        </button>`;
                    });
                    smartRepliesContainer.innerHTML = buttonsHtml;
                }
                else {
                    smartRepliesContainer.innerHTML = `<span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Brak odpowiedzi.</span>`;
                }
            }
            catch (err) {
                smartRepliesContainer.innerHTML = `<span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Błąd API.</span>`;
            }
        }

        function toggleCustomStyleField() {
            const toneSelect = document.getElementById("smartReplyTone");
            const customContainer = document.getElementById("customStyleContainer");
            
            if (toneSelect.value === "custom") {
                customContainer.classList.remove("d-none");
                document.getElementById("customStyleInput").focus();
            } 
            else {
                customContainer.classList.add("d-none");
            }
        }

        function useSmartReply(text) {
            const input = document.getElementById('messageInput');
            input.value = text;
            input.focus();
        }

        async function generateChatSummary() {
            const container = document.getElementById("summaryResultContainer");
            const startDate = document.getElementById("summaryDateStart").value;
            const endDate = document.getElementById("summaryDateEnd").value;

            container.innerHTML = `
                <div class="text-center p-4">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p class="small fw-bold text-muted">Analizuję historię...</p>
                </div>`;

            try {
                const summary = await connection.invoke("ChatSummary", "@Model.FriendId", startDate, endDate);
                
                container.innerHTML = `
                    <div class="p-3 border rounded-3 bg-light" style="font-size: 0.9rem;">
                        <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">Gotowe</span>
                            <small class="text-muted">${startDate}</small>
                        </div>
                        ${summary}
                    </div>`;
            } catch (err) {
                container.innerHTML = `<div class="alert alert-danger small p-2">Błąd generowania.</div>`;
            }
        }

        // ONLINE STATUS //

        function setOnlineStatus(isOnline) {
            const dot = document.getElementById("statusIndicator");
            if (isOnline) {
                dot.style.color = "#198754";
                dot.title = "Online";
            } 
            else {
                dot.style.color = "gray";
                dot.title = "Offline";
            }
        }

        connection.on("Online", function(userId) {
            if (userId && userId.toLowerCase() === "@Model.FriendId".toLowerCase()) {
                setOnlineStatus(true);
            }
        });

        connection.on("Offline", function(userId) {
            if (userId && userId.toLowerCase() === "@Model.FriendId".toLowerCase()) {
                setOnlineStatus(false);
            }
        });

        async function checkFriendStatus() {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    const isOnline = await connection.invoke("CheckStatus", "@Model.FriendId");
                    setOnlineStatus(isOnline);
                } 
                catch (err) { console.error("Nie udało się pobrać statusu:", err); }
            } 
            else if (connection) {
                setTimeout(checkFriendStatus, 50);
            }
        }
        checkFriendStatus();

        // SCROLL & MESSAGE HANDLING //

        const chatWindow = document.getElementById("chatWindow");
        let loadedMessagesCount = 30;
        let isLoadingOlder = false;
        let hasMoreMessages = true;

        chatWindow.addEventListener("scroll", async function() {
            if (chatWindow.scrollTop === 0 && !isLoadingOlder && hasMoreMessages) {
                isLoadingOlder = true;
                const previousScrollHeight = chatWindow.scrollHeight;

                try {
                    const response = await fetch(`/Chat/LoadOlderMessages?friendId=@Model.FriendId&skip=${loadedMessagesCount}`);
                    if (response.ok) {
                        const olderMessages = await response.json();
                        if (olderMessages.length > 0) {
                            loadedMessagesCount += olderMessages.length;
                            let olderHtml = "";
                            olderMessages.forEach(msg => {
                                const senderName = msg.senderId === "@Model.CurrentUserId" ? "You" : "@Model.FriendName";
                                const colorStyle = msg.senderId === "@Model.CurrentUserId" ? "color: #ae2eb8;" : "color: #111827;";
                                let contentHtml = msg.isImage ?
                                    `<br/><img src="data:${msg.contentType};base64,${msg.imageDataBase64}" class="chat-image" />` :
                                    `<span class="ms-1">${msg.content}</span>`;
                                olderHtml += `<div class="message-container mb-3"><strong style="${colorStyle}">${senderName}:</strong> ${contentHtml}</div>`;
                            });
                            chatWindow.insertAdjacentHTML('afterbegin', olderHtml);
                            chatWindow.scrollTop = chatWindow.scrollHeight - previousScrollHeight;
                        }
                        if (olderMessages.length < 30) hasMoreMessages = false;
                    }
                } 
                catch (err) { console.error("Błąd przy ładowaniu starszych wiadomości", err); } 
                finally { isLoadingOlder = false; }
            }
        });

        function appendMessage(senderId, content, isHtml) {
            const currentUserId = "@Model.CurrentUserId";
            const todayStr = "Dzisiaj";
            const dateSeparators = chatWindow.querySelectorAll('.date-separator span');
            let needsTodaySeparator = true;

            if (dateSeparators.length > 0) {
                const lastSeparatorText = dateSeparators[dateSeparators.length - 1].innerText;
                if (lastSeparatorText === todayStr) {
                    needsTodaySeparator = false;
                }
            }

            if (needsTodaySeparator) {
                const separatorDiv = document.createElement("div");
                separatorDiv.className = "d-flex align-items-center justify-content-center my-4 date-separator";
                separatorDiv.innerHTML = `
                <hr class="flex-grow-1 text-muted opacity-25 m-0">
                <span class="mx-3 text-muted fw-bold" style="font-size: 0.75rem; background-color: #f8f9fa; padding: 2px 10px; border-radius: 10px;">${todayStr}</span>
                <hr class="flex-grow-1 text-muted opacity-25 m-0">
                `;
                chatWindow.appendChild(separatorDiv);
            }

            const div = document.createElement("div");
            div.className = "message-container mb-3";
            const senderName = senderId === currentUserId ? "You" : "@Model.FriendName";
            const colorStyle = senderId === currentUserId ? "color: #ae2eb8;" : "color: #111827;";
            
            let innerContent = `<strong style="${colorStyle}">${senderName}:</strong> `;
            
            if (isHtml) {
                innerContent += content;
            } else {
                const tempDiv = document.createElement("div");
                tempDiv.innerText = content;
                innerContent += `<span class="ms-1">${tempDiv.innerHTML}</span>`;
            }

            if (senderId === currentUserId) {
                document.querySelectorAll('.read-status-container').forEach(el => el.remove());
                innerContent += `<div class="read-status-container text-muted mt-1" style="text-align: right; font-size: 0.75em;">Dostarczono ✓</div>`;
            }

            div.innerHTML = innerContent;
            chatWindow.appendChild(div);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        connection.on("ReceiveImage", function(senderId, receiverId, base64Data, contentType) {
            const imgHtml = `<br/><img src="data:${contentType};base64,${base64Data}" class="chat-image" />`;
            appendMessage(senderId, imgHtml, true);
        });

        connection.on("ReceiveMessage", function(senderId, receiverId, message) {
            appendMessage(senderId, message, false);
            
            if (senderId === "@Model.FriendId") {
                const isAuto = document.getElementById("autoGenerateSwitch").checked;
                if (isAuto) {
                    generateSmartReply();
                }
            }
        });

        connection.on("ErrorNotification", function(errorMessage) {
            alert(errorMessage);
        });

        connection.on("MessagesRead", function(readerId) {
            if (readerId === "@Model.FriendId") {
                document.querySelectorAll('.read-status-container').forEach(el => {
                    el.innerText = "Wyświetlono ✓✓";
                    el.style.color = "#3b82f6";
                });
            }
        });

        let hideIndicatorTimeout = null;
        const typingIndicator = document.getElementById("typingIndicator");

        connection.on("ReceiveWritingStatus", function(senderId) {
            if (senderId === "@Model.FriendId") {
                typingIndicator.style.display = "block";
                clearTimeout(hideIndicatorTimeout);
                hideIndicatorTimeout = setTimeout(function() {
                    typingIndicator.style.display = "none";
                }, 2000);
            }
        });

        function notifyMessagesRead() {
            const currentUserId = "@Model.CurrentUserId";
            const friendId = "@Model.FriendId";
            connection.invoke("MarkAsRead", currentUserId, friendId).catch(e => {});
            connection.invoke("ClearNotifications", currentUserId, friendId).catch(e => {});
        }

        document.getElementById("messageInput").addEventListener("focus", notifyMessagesRead);
        document.getElementById("chatWindow").addEventListener("click", notifyMessagesRead);
        setTimeout(notifyMessagesRead, 1500);

        let lastTypingTime = 0;
        document.getElementById("messageInput").addEventListener("input", function() {
            const now = Date.now();
            if (now - lastTypingTime > 1500) {
                connection.invoke("WritingStatus", "@Model.CurrentUserId", "@Model.FriendId").catch(e => {});
                lastTypingTime = now;
            }
        });

        document.getElementById("sendButton").addEventListener("click", function() {
            const messageInput = document.getElementById("messageInput");
            let message = parseEmoticons(messageInput.value);
            if (!message.trim()) return;

            const isAutoTranslate = document.getElementById("autoTranslateSwitch").checked;

            connection.invoke("SendMessage", "@Model.CurrentUserId", "@Model.FriendId", message, isAutoTranslate).catch(err => console.error(err.toString()));
            messageInput.value = "";
            
            smartRepliesContainer.innerHTML = `
                <div class="text-center text-muted fst-italic mt-4">
                    <i class="bi bi-chat-check fs-3 mb-2 d-block opacity-50"></i>
                    Wiadomość wysłana! Czekam na nową...
                </div>
            `;
        });

        document.getElementById("imageInput").addEventListener("change", function() {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onloadend = function() {
                const base64Data = reader.result.split(',')[1];
                const contentType = file.type;
                connection.invoke("SendImage", "@Model.CurrentUserId", "@Model.FriendId", base64Data, contentType).catch(e => {});
            };
            reader.readAsDataURL(file);
            this.value = "";
        });

        // Emoji //

        const emojiTriggerBtn = document.getElementById("emojiTriggerBtn");
        const msgInput = document.getElementById("messageInput");
        const picker = new EmojiButton({ position: 'top-start', theme: 'light', autoHide: false });
        picker.on('emoji', emoji => { msgInput.value += emoji; msgInput.focus(); });
        emojiTriggerBtn.addEventListener('click', () => { picker.togglePicker(emojiTriggerBtn); });

        // Forms binding //

        function bindMessageToForm(formId, hiddenInputId) {
            document.getElementById(formId).addEventListener("submit", function() {
                var message = document.getElementById("messageInput").value;
                document.getElementById(hiddenInputId).value = message;
            });
        }
        bindMessageToForm("CorrectForm", "userMessageCorrect");
        bindMessageToForm("TranslateForm", "userMessageTranslate");
    </script>

