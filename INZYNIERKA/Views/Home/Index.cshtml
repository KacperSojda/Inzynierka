@using Microsoft.AspNetCore.Identity;
@using INZYNIERKA.Domain.Models;
@inject SignInManager<User> signInManager;

@{
    ViewData["Title"] = "Home Page";
}

<div class="my-container flex-column">

    @if (!signInManager.IsSignedIn(User))
    {
        <div class="text-center mb-5">
            <h1 class="fw-bold">Welcome to the website!</h1>
            <p class="text-muted mt-3">Register or log in to meet people who share your interests</p>
        </div>

        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="nav-card gradient-main">
                <i class="display-4 mb-2 bi-person-plus-fill"></i>
                <h3>Register</h3>
            </a>
            <a asp-controller="Account" asp-action="Login" class="nav-card gradient-main">
                <i class="display-4 mb-2 bi-box-arrow-in-right"></i>
                <h3>Log In</h3>
            </a>
        </div>
    }
    else
    {
        <div class="text-center mb-5 mt-4">
            <h1 class="display-4 fw-bold">Welcome @ViewBag.UserName!</h1>
            <p class="text-muted mt-3">Chat with friends, explore users, or join thematic groups</p>
        </div>

        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <a asp-controller="Group" asp-action="Index" class="nav-card gradient-main">
                <i class="display-4 bi-people-fill"></i>
                <h3>Groups</h3>
            </a>
            <a asp-controller="Browser" asp-action="SearchUsersByTags" class="nav-card gradient-main">
                <i class="display-4 bi-search"></i>
                <h3>Browser</h3>
            </a>
            <a asp-controller="Profile" asp-action="Index" class="nav-card gradient-main">
                <i class="display-4 bi bi-person-circle"></i>
                <h3>Profile</h3>
            </a>
        </div>
    }
</div>