@using Microsoft.AspNetCore.Identity;
@using INZYNIERKA.Domain.Models;
@inject SignInManager<User> signInManager;

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex flex-column align-items-center">

    @if (!signInManager.IsSignedIn(User))
    {
        <div class="text-center mb-5 mt-4">
            <h1 class="display-4 fw-bold" style="color: #111827;">Welcome to the website!</h1>
            <p class="lead text-muted mt-3">Register or log in to meet people who share your interests</p>
        </div>

        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <a asp-controller="Account" asp-action="Register" class="home-card">
                <i class="bi bi-person-plus-fill"></i>
                <h3>Register</h3>
            </a>
            <a asp-controller="Account" asp-action="Login" class="home-card">
                <i class="bi bi-box-arrow-in-right"></i>
                <h3>Log In</h3>
            </a>
        </div>
    }
    else
    {
        <div class="text-center mb-5 mt-4">
            <h1 class="display-4 fw-bold" style="color: #111827;">Welcome @ViewBag.UserName!</h1>
            <p class="lead text-muted mt-3">Chat with friends, explore users, or join thematic groups</p>
        </div>

        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <a asp-controller="Group" asp-action="Index" class="home-card">
                <i class="bi bi-people-fill"></i>
                <h3>Groups</h3>
            </a>
            <a asp-controller="Browser" asp-action="SearchUsersByTags" class="home-card">
                <i class="bi bi-search"></i>
                <h3>Browser</h3>
            </a>
            <a asp-controller="Profile" asp-action="Index" class="home-card">
                <i class="bi bi-person-circle"></i>
                <h3>Profile</h3>
            </a>
        </div>
    }

</div>

<style>
    .home-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        padding: 40px 20px;
        border-radius: 20px;
        width: 260px;
        text-decoration: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .home-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(174, 46, 184, 0.3);
            color: white;
        }

        .home-card i {
            font-size: 3.5rem;
            margin-bottom: 20px;
        }

        .home-card h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
</style>