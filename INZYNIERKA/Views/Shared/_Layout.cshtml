<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INZYNIERKA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/INZYNIERKA.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />
</head>
<body>
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark top-navbar shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">WebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        bool isAuthPage = currentController == "Account";
        bool isHomePage = currentController == "Home";
        bool isUserLoggedIn = User.Identity?.IsAuthenticated == true;
        bool hideSidebar = isAuthPage || (isHomePage && !isUserLoggedIn);
    }

    <div class="d-flex align-items-stretch">
        
        @if (!hideSidebar)
        {
            <nav class="app-sidebar d-none d-lg-flex flex-column flex-shrink-0 p-3 bg-white border-end shadow-sm">
                <ul class="nav nav-pills flex-column mb-auto gap-2">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link sidebar-link @(currentController == "Home" ? "active" : "")">
                            <i class="bi bi-house-door me-2"></i> Main Page
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Profile" asp-action="Index" class="nav-link sidebar-link @(currentController == "Profile" && currentAction != "Notifications" ? "active" : "")">
                            <i class="bi bi-person me-2"></i> Profile
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Browser" asp-action="SearchUsersByTags" class="nav-link sidebar-link @(currentController == "Browser" ? "active" : "")">
                            <i class="bi bi-search me-2"></i> Search
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Group" asp-action="Index" class="nav-link sidebar-link @(currentController == "Group" ? "active" : "")">
                            <i class="bi bi-collection me-2"></i> Groups
                        </a>
                    </li>
                </ul>
                
                <hr class="text-muted" />
                
                <ul class="nav nav-pills flex-column">
                    <li>
                        <a asp-controller="Profile" asp-action="Notifications" class="nav-link sidebar-link @(currentController == "Profile" && currentAction == "Notifications" ? "active" : "")">
                            <i class="bi bi-bell me-2"></i> Notifications
                        </a>
                    </li>
                </ul>
            </nav>
        }

        <div class="container-fluid px-4 flex-grow-1">
            <main role="main" class="pb-3">
                
                <div class="mt-3">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        window.appSignalRConnection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .withAutomaticReconnect()
        .build();
        window.appSignalRConnection.start().catch(err => console.error("Globalny błąd SignalR:", err));
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

<style>
    .top-navbar {
        background: linear-gradient(135deg, #a132a1, #c973c9);
    }

    .app-sidebar {
    width: 250px;
        min-height: calc(100vh - 76px);
    }

    .sidebar-link {
        color: #4b5563;
        padding: 12px 15px;
        border-radius: 10px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .sidebar-link i {
        font-size: 1.25rem;
    }

    .sidebar-link:hover {
        background-color: #f8f9fa;
        color: #111827;
    }

    .sidebar-link.active {
        background: linear-gradient(135deg, #552459, #ae2eb8) !important;
        color: white !important;
        box-shadow: 0 4px 12px rgba(174, 46, 184, 0.25);
    }
</style>