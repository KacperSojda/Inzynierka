@model INZYNIERKA.Services.ViewModels.TagViewModel

@{
    ViewData["Title"] = "Add Tag Page";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card-tag text-center p-5 w-100" style="max-width: 500px;">
        <div class="mb-3">
            <i class="bi bi-tag-fill" style="font-size: 3rem; color: #552459;"></i>
        </div>
        <h2 class="fw-bold mb-4" style="color: #111827;">Add Tag</h2>

        <form asp-action="AddTag" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small fw-bold mb-3 text-start"></div>

            <div class="mb-4 text-start">
                <label asp-for="TagName" class="form-label fw-bold text-muted"></label>
                <input asp-for="TagName" class="form-control my-input" placeholder="Enter tag name..." />
                <span asp-validation-for="TagName" class="text-danger"></span>
            </div>
            
            <button type="submit" class="btn-tag w-100">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card-tag {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .btn-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 0;
        border-radius: 15px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        color: white;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .btn-tag:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
            color: white;
        }
</style>