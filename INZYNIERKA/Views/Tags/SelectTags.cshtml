@model INZYNIERKA.Services.ViewModels.SelectTagsViewModel

@{
    ViewData["Title"] = "Choose Tags";
}

<div class="container py-5 text-center">
    <div class="row mb-4">
        <div class="col">
            <h2 class="display-5 fw-bold" style="color: #111827;">Choose your tags</h2>
            <p class="text-muted">
                Mark topics that interest you to better tailor your profile.
            </p>
        </div>
    </div>

    <form asp-action="SelectTags" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-4" style="font-size: 1.1rem;"></div>

        <div class="tags-container justify-content-center mb-5">
            @for (int i = 0; i < Model.Tags.Count; i++)
            {
                <input type="hidden" asp-for="Tags[i].TagId" />
                <input type="checkbox" asp-for="Tags[i].Selected" id="tag-@i" class="tag-checkbox" />
                
                <label for="tag-@i" class="tag-block">
                    @Model.Tags[i].TagName
                    <span class="checkmark">✓</span>
                </label>
            }
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="save">Save</button>
            <a asp-action="AddTag" class="add-tag" title="Dodaj Tag" data-bs-toggle="tooltip">
                Add Tag
            </a>
        </div>
    </form>
</div>

<style>
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .tag-checkbox {
        display: none;
    }

    .tag-block {
        position: relative;
        display: inline-block;
        padding: 10px 22px;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        border-radius: 20px;
        font-weight: 500;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
        user-select: none;
    }

        .tag-block:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

    .checkmark {
        position: absolute;
        top: -6px;
        right: -6px;
        background: #32b528;
        color: white;
        border-radius: 50%;
        font-size: 14px;
        font-weight: bold;
        width: 22px;
        height: 22px;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transform: scale(0);
        transition: all 0.3s ease;
    }

    .tag-checkbox:checked + .tag-block {
        background: linear-gradient(135deg, #1c7a15, #32b528);
        box-shadow: 0 8px 20px rgba(28, 122, 21, 0.4);
        transform: translateY(-3px);
    }

        .tag-checkbox:checked + .tag-block .checkmark {
            opacity: 1;
            transform: scale(1);
        }

    .save, .add-tag {
        display: inline-block;
        text-align: center;
        padding: 12px 0;
        border-radius: 15px;
        width: 180px;
        font-weight: bold;
        font-size: 1.1rem;
        text-decoration: none;
        color: white;
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .save {
        background: linear-gradient(135deg, #1c7a15, #32b528);
    }

    .add-tag {
        background: linear-gradient(135deg, #757009, #cfc61d);
    }

        .save:hover, .add-tag:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
            color: white;
        }
</style>