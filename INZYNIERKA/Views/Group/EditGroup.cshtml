@model INZYNIERKA.Services.ViewModels.EditGroupViewModel

@{
    ViewData["Title"] = "Edit Group";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5 d-flex justify-content-center">
    <div class="card-group-form p-5 w-100" style="max-width: 600px;">
        
        <div class="text-center mb-4">
            <i class="bi bi-gear-fill" style="font-size: 3rem; color: #552459;"></i>
            <h2 class="fw-bold mt-3">Edit Group</h2>
            <p class="text-muted">Manage settings for <strong>@Model.Name</strong></p>
        </div>

        <form id="editGroupForm" asp-action="EditGroup" method="post" class="mb-4">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold text-muted"></label>
                <input asp-for="Name" class="form-control my-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold text-muted">Group Description</label>
                <textarea asp-for="Description" class="form-control my-input" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <button type="submit" form="editGroupForm" class="btn-group-edit gradient-green w-100">
                <i class="bi bi-check-circle me-2"></i> Save changes
            </button>
        </form>

        <hr class="my-4 text-muted opacity-25" />

        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center">
            
            <form asp-action="SelectGroupTags" method="get" class="m-0 flex-grow-1">
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" class="btn-group-edit gradient-yellow w-100">
                    <i class="bi bi-tags me-2"></i> Edit tags
                </button>
            </form>

            <form asp-action="ShowBannedMembers" method="get" class="m-0 flex-grow-1">
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" class="btn-group-edit gradient-pink w-100">
                    <i class="bi bi-shield-x me-2"></i> Banned users
                </button>
            </form>

            <form asp-action="DeleteGroup" method="post" class="m-0 flex-grow-1" onsubmit="return confirm('Are you sure you want to delete this group?');">
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" class="btn-group-edit gradient-pink w-100">
                    <i class="bi bi-trash3 me-2"></i> Delete group
                </button>
            </form>
            
        </div>

    </div>
</div>