@model INZYNIERKA.Services.ViewModels.GroupViewModel

@{
    ViewData["Title"] = "Available Groups";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5">Available Groups</h2>
        <p class="text-muted">Discover and join new communities matching your interests</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12" style="max-width: 900px;">

        @if ((Model.Groups != null && Model.Groups.Any()) || !string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
        {
                <form method="get" asp-action="ShowAvailableGroups" class="mb-4 w-100">
                    <div class="input-group shadow-sm" style="border-radius: 15px; overflow: hidden; border: 1px solid #f0f0f0;">
                        <input type="text" name="searchQuery" value="@Context.Request.Query["searchQuery"]" class="form-control border-0 py-2 shadow-none" placeholder="Search group by name...">
                        
                        <button type="submit" class="btn px-4 border-0" style="background: linear-gradient(135deg, #552459, #ae2eb8); color: white;">
                            <i class="bi bi-search me-1"></i> Search
                        </button>

                        @if (!string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
                        {
                            <a asp-action="ShowAvailableGroups" class="btn btn-light px-3 border-start d-flex align-items-center" title="Clear search">
                                <i class="bi bi-x-lg text-danger"></i>
                            </a>
                        }
                    </div>
                </form>
        }

            @if (Model.Groups != null && Model.Groups.Any())
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var group in Model.Groups)
                    {
                        <div class="card-new-group-list p-4 group-item" data-name="@group.Name.ToLower()">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                                <h3 class="fw-bold mb-3 mb-md-0" style="color: #111827;">@group.Name</h3>
                               
                                <div class="group-menu gap-2">
                                    <form asp-action="JoinGroup" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="btn-new-group-list gradient-green" title="Join Group"><i class="bi bi-person-plus-fill me-1"></i> Join</button>
                                    </form>
                                </div>
                            </div>

                            <p class="text-secondary mb-3">@group.Description</p>

                            @if (group.Tags != null && group.Tags.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <span class="badge badge-group">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
                string currentSearch = Context.Request.Query["searchQuery"];

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4 w-100">
                        <nav aria-label="Available group page navigation">
                            <ul class="pagination pagination-sm shadow-sm" style="border-radius: 10px;">
                                
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link text-dark" asp-action="ShowAvailableGroups" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link @(currentPage == i ? "text-white" : "text-dark")" 
                                           style="@(currentPage == i ? "background: linear-gradient(135deg, #552459, #ae2eb8); border-color: #ae2eb8;" : "")"
                                           asp-action="ShowAvailableGroups" 
                                           asp-route-searchQuery="@currentSearch" 
                                           asp-route-page="@i">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link text-dark" asp-action="ShowAvailableGroups" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center mt-5">
                    <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-3 text-muted">No groups available.</h4>
                    <p class="text-secondary">Be the first to create a new community!</p>
                    <a asp-controller="Group" asp-action="CreateGroup" class="btn-new-group-list gradient-green mt-3"><i class="bi bi-plus-circle me-2"></i>Create Group</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterAvailableGroups() {
            const searchString = document.getElementById('availableGroupSearchInput').value.toLowerCase();
            const groupItems = document.querySelectorAll('.group-item');

            groupItems.forEach(item => {
                const groupName = item.getAttribute('data-name');
                
                if (groupName.includes(searchString)) {
                    item.classList.remove('d-none');
                } else {
                    item.classList.add('d-none');
                }
            });
        }
    </script>
}

<style>
    .card-new-group-list {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-new-group-list:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .btn-new-group-list {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 12px;
        height: 40px;
        text-decoration: none;
        color: white;
        font-weight: bold;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-new-group-list:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white;
    }
</style>