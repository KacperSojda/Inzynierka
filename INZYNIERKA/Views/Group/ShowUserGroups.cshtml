@model INZYNIERKA.Services.ViewModels.GroupViewModel

@{
    ViewData["Title"] = "Twoje Grupy";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #111827;">Your groups</h2>
        <p class="text-muted">Manage the communities you own or are part of</p>
    </div>

    @if (!Model.AdminGroups.Any() && !Model.Groups.Any())
    {
        <div class="text-center mt-5">
            <i class="bi bi-people text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">You don't belong to any group!</h4>
            <a asp-controller="Group" asp-action="ShowAvailableGroups" class="action-btn btn-show mt-3">Search for groups</a>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12" style="max-width: 900px;">
            
            @if (Model.AdminGroups.Any())
            {
                <h4 class="fw-bold mb-4" style="color: #552459;"><i class="bi bi-shield-lock-fill me-2"></i>Admin</h4>
                <div class="d-flex flex-column gap-4 mb-5">
                    @foreach (var group in Model.AdminGroups)
                    {
                        <div class="group-list-card p-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                                <h3 class="fw-bold mb-3 mb-md-0" style="color: #111827;">@group.Name</h3>
                                
                                <div class="action-menu gap-2">
                                    <form asp-action="LeaveGroup" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-leave" title="Leave"><i class="bi bi-box-arrow-right"></i></button>
                                    </form>
                                    <form asp-action="ShowGroupMembers" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-show" title="Members"><i class="bi bi-people"></i></button>
                                    </form>
                                    <form asp-action="GroupChat" asp-controller="Chat" method="get" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-chat" title="Chat"><i class="bi bi-chat-dots"></i></button>
                                    </form>
                                    <form asp-action="EditGroup" asp-controller="Group" method="get" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-edit" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                    </form>
                                </div>
                            </div>

                            <p class="text-secondary mb-3">@group.Description</p>

                            @if (group.Tags.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <span class="badge custom-badge">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (Model.Groups.Any())
            {
                <h4 class="fw-bold mb-4" style="color: #111827;"><i class="bi bi-people-fill me-2"></i>Member</h4>
                <div class="d-flex flex-column gap-4">
                    @foreach (var group in Model.Groups)
                    {
                        <div class="group-list-card p-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                                <h3 class="fw-bold mb-3 mb-md-0" style="color: #111827;">@group.Name</h3>
                                
                                <div class="action-menu gap-2">
                                    <form asp-action="LeaveGroup" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-leave" title="Leave"><i class="bi bi-box-arrow-right"></i></button>
                                    </form>
                                    <form asp-action="ShowGroupMembers" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-show" title="Members"><i class="bi bi-people"></i></button>
                                    </form>
                                    <form asp-action="GroupChat" asp-controller="Chat" method="get" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="action-btn btn-chat" title="Chat"><i class="bi bi-chat-dots"></i></button>
                                    </form>
                                </div>
                            </div>

                            <p class="text-secondary mb-3">@group.Description</p>

                            @if (group.Tags.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <span class="badge custom-badge">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .group-list-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .group-list-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .action-menu {
        display: flex;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border-radius: 12px;
        width: 50px;
        height: 40px;
        text-decoration: none;
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-btn i {
        font-size: 1.1rem;
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white;
    }

    .btn-leave { background: linear-gradient(135deg, #8c144c, #d43780); }
    .btn-show  { background: linear-gradient(135deg, #1c7a15, #32b528); }
    .btn-chat  { background: linear-gradient(135deg, #1b3480, #4565c4); }
    .btn-edit  { background: linear-gradient(135deg, #757009, #cfc61d); }

    .custom-badge {
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        padding: 8px 15px;
        border-radius: 12px;
        font-weight: 500;
        box-shadow: 0 4px 10px rgba(174, 46, 184, 0.2);
    }
</style>