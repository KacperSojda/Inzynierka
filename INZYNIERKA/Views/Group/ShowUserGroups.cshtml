@model INZYNIERKA.Services.ViewModels.GroupViewModel

@{
    ViewData["Title"] = "Your Groups";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5">Your groups</h2>
        <p class="text-muted">Manage the communities you own or are part of</p>
    </div>

    @if (!Model.Groups.Any() && string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
    {
        <div class="text-center mt-5">
            <i class="bi bi-people text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">You don't belong to any group!</h4>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12" style="max-width: 900px;">
            
            @if (Model.Groups.Any() || !string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
            {
                <form method="get" asp-action="ShowUserGroups" class="mb-4 w-100">
                    <div class="input-group shadow-sm" style="border-radius: 15px; overflow: hidden; border: 1px solid #f0f0f0;">
                        <input type="text" name="searchQuery" value="@Context.Request.Query["searchQuery"]" class="form-control border-0 py-2 shadow-none" placeholder="Search group by name...">
                        
                        <button type="submit" class="btn px-4 border-0" style="background: linear-gradient(135deg, #552459, #ae2eb8); color: white;">
                            <i class="bi bi-search me-1"></i> Search
                        </button>

                        @if (!string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
                        {
                            <a asp-action="ShowUserGroups" class="btn btn-light px-3 border-start d-flex align-items-center" title="Clear Search">
                                <i class="bi bi-x-lg text-danger"></i>
                            </a>
                        }
                    </div>
                </form>

                @if (!Model.Groups.Any())
                {
                    <div class="text-center mt-5 w-100">
                        <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">No groups found matching the query.</h5>
                    </div>
                }
            }

            @if (Model.Groups.Any())
            {
                <div class="d-flex flex-column gap-4 mb-5">
                    @foreach (var group in Model.Groups)
                    {
                        <div class="card-group-list p-4 group-item" data-name="@group.Name.ToLower()">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                                
                                <h3 class="fw-bold mb-3 mb-md-0 d-flex align-items-center">
                                    @group.Name
                                    @if (group.IsAdmin)
                                    {
                                        <span class="badge ms-2" style="font-size: 0.5em; background-color: #8c144c; vertical-align: middle;">Admin</span>
                                    }
                                </h3>
                                
                                <div class="menu-group gap-2">
                                    <form asp-action="LeaveGroup" method="post" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="btn-group-list gradient-pink" title="Leave"><i class="bi bi-box-arrow-right"></i></button>
                                    </form>
                                    <form asp-action="ShowGroupMembers" method="get" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="btn-group-list gradient-green" title="Members"><i class="bi bi-people"></i></button>
                                    </form>
                                    <form asp-action="GroupChat" asp-controller="Chat" method="get" class="m-0">
                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                        <button type="submit" class="btn-group-list gradient-blue" title="Chat"><i class="bi bi-chat-dots"></i></button>
                                    </form>
                                    
                                    @if (group.IsAdmin)
                                    {
                                        <form asp-action="EditGroup" asp-controller="Group" method="get" class="m-0">
                                            <input type="hidden" name="groupId" value="@group.GroupId" />
                                            <button type="submit" class="btn-group-list gradient-yellow" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <p class="text-secondary mb-3">@group.Description</p>

                            @if (group.Tags.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <span class="badge badge-group">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                
                int currentPage = ViewBag.CurrentPage ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
                string currentSearch = Context.Request.Query["searchQuery"];

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4 w-100">
                        <nav aria-label="Group page navigation">
                            <ul class="pagination pagination-sm shadow-sm" style="border-radius: 10px;">
                                
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link text-dark" asp-action="ShowUserGroups" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link @(currentPage == i ? "text-white" : "text-dark")" 
                                           style="@(currentPage == i ? "background: linear-gradient(135deg, #552459, #ae2eb8); border-color: #ae2eb8;" : "")"
                                           asp-action="ShowUserGroups" 
                                           asp-route-searchQuery="@currentSearch" 
                                           asp-route-page="@i">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link text-dark" asp-action="ShowUserGroups" asp-route-searchQuery="@currentSearch" asp-route-page="@(currentPage + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>