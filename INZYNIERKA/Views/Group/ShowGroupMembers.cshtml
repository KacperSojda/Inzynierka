@model INZYNIERKA.Services.ViewModels.GroupMembersViewModel

@{
    ViewData["Title"] = "Członkowie Grupy";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5" style="color: #111827;">Group Members</h2>
        <p class="text-muted">Manage administrators and users of your group</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12" style="max-width: 800px;">
            
            <div class="mb-4 w-100">
                <div class="input-group shadow-sm" style="border-radius: 15px; overflow: hidden; border: 1px solid #f0f0f0;">
                    <span class="input-group-text bg-white border-0 px-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="memberSearchInput" class="form-control border-0 py-2 shadow-none" placeholder="Szukaj członka po nazwie..." onkeyup="filterMembers()">
                </div>
            </div>

            <h4 class="fw-bold mb-3" style="color: #552459;"><i class="bi bi-shield-lock-fill me-2"></i>Administrators</h4>
            <div class="d-flex flex-column gap-3 mb-5">
                @foreach (var admin in Model.Admins)
                {
                    <div class="list-card d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 px-4 w-100 member-item" data-name="@admin.Name.ToLower()">
                        <strong class="fs-5 mb-3 mb-md-0" style="color: #111827;">@admin.Name</strong>
                        
                        <div class="action-menu gap-2">
                            @if (Model.Admins.Any(a => a.UserId == Model.CurrentUserId) && admin.UserId != Model.CurrentUserId)
                            {
                                <form asp-action="DemoteAdmin" asp-controller="Group" method="post" class="m-0">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@admin.UserId" />
                                    <button type="submit" class="action-btn btn-danger-gradient" title="Demote Admin"><i class="bi bi-arrow-down-circle"></i></button>
                                </form>
                                <form asp-action="KickUser" asp-controller="Group" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to remove this user?');">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@admin.UserId" />
                                    <button type="submit" class="action-btn btn-danger-gradient" title="Kick"><i class="bi bi-door-closed"></i></button>
                                </form>
                                <form asp-action="BanUser" method="post" class="m-0">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@admin.UserId" />
                                    <button type="submit" class="action-btn btn-danger-gradient" title="Ban"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }

                            @if (admin.UserId != Model.CurrentUserId)
                            {
                                <form asp-action="ShowProfile" asp-controller="Profile" method="post" class="m-0">
                                    <input type="hidden" name="userId" value="@admin.UserId" />
                                    <button type="submit" class="action-btn btn-profile" title="Show Profile"><i class="bi bi-person"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

            <h4 class="fw-bold mb-3" style="color: #111827;"><i class="bi bi-people-fill me-2"></i>Members</h4>
            <div class="d-flex flex-column gap-3">
                @foreach (var member in Model.Members)
                {
                    <div class="list-card d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 px-4 w-100 member-item" data-name="@member.Name.ToLower()">
                        <strong class="fs-5 mb-3 mb-md-0" style="color: #111827;">@member.Name</strong>
                        
                        <div class="action-menu gap-2">
                            @if (Model.Admins.Any(a => a.UserId == Model.CurrentUserId))
                            {
                                <form asp-action="GiveAdmin" asp-controller="Group" method="post" class="m-0">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@member.UserId" />
                                    <button type="submit" class="action-btn btn-success-gradient" title="Give Admin"><i class="bi bi-arrow-up-circle"></i></button>
                                </form>
                                <form asp-action="KickUser" asp-controller="Group" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to remove this user?');">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@member.UserId" />
                                    <button type="submit" class="action-btn btn-danger-gradient" title="Kick"><i class="bi bi-door-closed"></i></button>
                                </form>
                                <form asp-action="BanUser" method="post" class="m-0">
                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                    <input type="hidden" name="userId" value="@member.UserId" />
                                    <button type="submit" class="action-btn btn-danger-gradient" title="Ban"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }

                            @if (member.UserId != Model.CurrentUserId)
                            {
                                <a asp-controller="Profile" asp-action="ShowProfile" asp-route-userId="@member.UserId" class="action-btn btn-profile" title="Show Profile" data-bs-toggle="tooltip">
                                     <i class="bi bi-person"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterMembers() {
            const searchString = document.getElementById('memberSearchInput').value.toLowerCase();
            const memberItems = document.querySelectorAll('.member-item');

            memberItems.forEach(item => {
                const memberName = item.getAttribute('data-name');
                
                if (memberName.includes(searchString)) {
                    item.classList.remove('d-none');
                    item.classList.add('d-flex');
                } else {
                    item.classList.remove('d-flex');
                    item.classList.add('d-none');
                }
            });
        }
    </script>
}

<style>
    .list-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .list-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .action-menu {
        display: flex;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border-radius: 12px;
        width: 50px;
        height: 40px;
        text-decoration: none;
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-btn i {
        font-size: 1.2rem;
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white;
    }

    .btn-danger-gradient  { background: linear-gradient(135deg, #8c144c, #d43780); }
    .btn-success-gradient { background: linear-gradient(135deg, #1c7a15, #32b528); }
    .btn-profile          { background: linear-gradient(135deg, #757009, #cfc61d); }
</style>