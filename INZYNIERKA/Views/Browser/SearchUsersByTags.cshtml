@model INZYNIERKA.Services.ViewModels.SearchByTagsViewModel

@{
    ViewData["Title"] = "Szukaj po tagach";
}

<div class="container py-5 text-center">
    <div class="row mb-4">
        <div class="col">
            <h2 class="display-5 fw-bold" style="color: #111827;">Search users by tags</h2>
            <p class="text-muted">Wybierz tagi, aby znaleźć osoby o podobnych zainteresowaniach.</p>
        </div>
    </div>

    <form method="post">
        <div class="tags-container justify-content-center mb-4">
            @for (int i = 0; i < Model.AvailableTags.Count; i++)
            {
                <input type="hidden" asp-for="AvailableTags[i].TagId" />
                <input type="checkbox" asp-for="AvailableTags[i].IsSelected" id="tag-@i" class="tag-checkbox" />
                
                <label for="tag-@i" class="tag-block">
                    @Model.AvailableTags[i].TagName
                    <span class="checkmark">✓</span>
                </label>
            }
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button type="submit" class="save action-btn">Search</button>
            <a asp-controller="Browser" asp-action="SearchWithAI" class="AIsearch action-btn" title="Search by AI" data-bs-toggle="tooltipp">
                <i class="bi bi-pencil-square"></i> Search with AI
            </a>
        </div>
    </form>
</div>

<style>
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .tag-checkbox {
        display: none;
    }

    .tag-block {
        position: relative;
        display: inline-block;
        padding: 10px 22px;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        border-radius: 20px;
        font-weight: 500;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
        user-select: none;
    }

        .tag-block:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

    .checkmark {
        position: absolute;
        top: -6px;
        right: -6px;
        background: #32b528;
        color: white;
        border-radius: 50%;
        font-size: 14px;
        font-weight: bold;
        width: 22px;
        height: 22px;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transform: scale(0);
        transition: all 0.3s ease;
    }

    .tag-checkbox:checked + .tag-block {
        background: linear-gradient(135deg, #1c7a15, #32b528);
        box-shadow: 0 8px 20px rgba(28, 122, 21, 0.4);
        transform: translateY(-3px);
    }

        .tag-checkbox:checked + .tag-block .checkmark {
            opacity: 1;
            transform: scale(1);
        }

    .action-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 12px 25px;
        border-radius: 15px;
        font-weight: bold;
        font-size: 1.1rem;
        text-decoration: none;
        color: white;
        border: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .save {
        background: linear-gradient(135deg, #1c7a15, #32b528);
    }

    .AIsearch {
        background: linear-gradient(135deg, #ae2eb8, #3b82f6);
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        color: white;
    }
</style>