@model INZYNIERKA.Services.ViewModels.SearchByTagsViewModel

@{
    ViewData["Title"] = "Search Users";
}

<div class="container py-5 text-center">
    <div class="row mb-4">
        <div class="col">
            <h2 class="display-5 fw-bold" style="color: #111827;">Search users</h2>
            <p class="text-muted">Find users by profile data or select tags.</p>
        </div>
    </div>

    <form method="post">

        <div class="tags-container justify-content-center mb-5" style="max-width: 800px; margin: 0 auto;">
            @for (int i = 0; i < Model.AvailableTags.Count; i++)
            {
                <input type="hidden" asp-for="AvailableTags[i].TagId" />
                <input type="checkbox" asp-for="AvailableTags[i].Selected" id="tag-@i" class="tag-checkbox" />
                
                <label for="tag-@i" class="tag-block">
                    @Model.AvailableTags[i].TagName
                    <span class="checkmark">✓</span>
                </label>
            }
        </div>
        
        <div class="row justify-content-center mb-5 text-start">
            <div class="col-12" style="max-width: 800px;">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4" style="color: #552459;"><i class="bi bi-funnel-fill me-2"></i>Basic Filters</h5>
                    
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="SearchName" class="form-label small fw-bold text-muted">User Name</label>
                            <input asp-for="SearchName" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. Kacper" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SearchCity" class="form-label small fw-bold text-muted">City</label>
                            <input asp-for="SearchCity" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. Warsaw" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SearchCountry" class="form-label small fw-bold text-muted">Country</label>
                            <input asp-for="SearchCountry" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. Poland" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button type="submit" class="btn-browser gradient-green"><i class="bi bi-search me-1"></i> Search</button>
            <a asp-controller="Browser" asp-action="SearchWithAI" class="btn-browser gradient-ai" title="Search by AI" data-bs-toggle="tooltip">
                <i class="bi bi-robot"></i> Search with AI
            </a>
        </div>
    </form>
</div>

<style>
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .tag-checkbox {
        display: none;
    }

    .tag-block {
        position: relative;
        display: inline-block;
        padding: 10px 22px;
        background: linear-gradient(135deg, #552459, #ae2eb8);
        color: white;
        border-radius: 20px;
        font-weight: 500;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
        user-select: none;
    }

        .tag-block:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.2);
        }

    .checkmark {
        position: absolute;
        top: -6px;
        right: -6px;
        background: #32b528;
        color: white;
        border-radius: 50%;
        font-size: 14px;
        font-weight: bold;
        width: 22px;
        height: 22px;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transform: scale(0);
        transition: all 0.3s ease;
    }

    .tag-checkbox:checked + .tag-block {
        background: linear-gradient(135deg, #1c7a15, #32b528);
        box-shadow: 0 8px 20px rgba(28, 122, 21, 0.4);
        transform: translateY(-3px);
    }

        .tag-checkbox:checked + .tag-block .checkmark {
            opacity: 1;
            transform: scale(1);
        }
</style>