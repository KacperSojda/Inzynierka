@model INZYNIERKA.Services.ViewModels.UserViewModel

@{
    ViewData["Title"] = "AI Results";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card-browser text-center p-5">
        
        <div class="mb-3">
            <i class="bi bi-robot" style="font-size: 4rem; color: #ae2eb8;"></i>
        </div>

        <h3 class="fw-bold mb-3">@Model.UserName</h3>
        
        <p class="text-muted mb-4" style="font-size: 1.1rem;">
            @Model.PublicDescription
        </p>

        <div class="tags-wrapper mb-5">
            @foreach (var tag in Model.Tags)
            {
                <span class="badge badge-browser mx-1 mb-2">@tag</span>
            }
        </div>

        <div class="buttons-wrapper d-flex justify-content-center gap-3 flex-wrap">
            <form asp-action="SendFriendRequest" method="post" style="display:inline;">
                <input type="hidden" name="userId" value="@Model.Id" />
                <button type="submit" class="btn-browser gradient-green" title="Send friend requests" data-bs-toggle="tooltip">
                    <i class="bi bi-person-add"></i> Add
                </button>
            </form>

            <form asp-action="ShowUserWithAI" method="get" style="display:inline;">
                <button type="submit" class="btn-browser gradient-blue">Next &rarr;</button>
            </form>

            <form asp-controller="Profile" asp-action="ShowProfile" method="post" style="display:inline;">
                <input type="hidden" name="userId" value="@Model.Id" />
                <button type="submit" class="btn-browser gradient-yellow">Profile</button>
            </form>
        </div>
    </div>
</div>